#pragma kernel SolveCascade
#pragma kernel SolveAutomaticNormals
#pragma kernel ResolveDirect
#pragma kernel SolveDiffuseBounce
#pragma kernel CompositeLighting

#pragma target 5.0

#define PI 3.14159265359
#define PI2 6.28318530718
#define MAX_INTERVAL_STEPS 64

Texture2D<float4> _MaterialField;
Texture2D<float4> _EmissionField;
RWStructuredBuffer<uint3> _RadianceAtlas;
RWTexture2D<float4> _DirectTexture;
RWTexture2D<float4> _AutomaticNormalField;
Texture2D<float4> _AutomaticNormalInput;
Texture2D<float4> _DirectInput;

// Resolved radiance from the terrain's own emitters, solved separately and kept
// across frames.
//
// Light transport is linear in emission and the medium does not depend on it, so
// solve(terrain + lamps) is exactly solve(terrain) + solve(lamps). Splitting the
// two lets the terrain half survive until geometry actually changes, instead of
// being recomputed every time a lamp moves a fraction of a cell - which is what
// made walking cost a full cascade solve per frame.
Texture2D<float4> _StaticDirectInput;

RWTexture2D<float4> _BounceTexture;
Texture2D<float4> _BounceInput;
RWTexture2D<float4> _Result;

int2 _FieldSize;
int2 _BounceSize;
float4 _WorldRect;
float4 _AmbientColor;
float4 _EmptyExtinctionRgb;
float4 _SolidExtinctionRgb;
float _MinimumTransmission;
float _BounceStrength;
float _EmissionScale;
float _MaximumLightMultiplier;
float _CellSize;
float _TransmittanceDebugDistanceCells;
int _DebugView;
int _MaterialYFlip;
int _MaximumIntervalSteps;
int _EnableDiffuseBounce;
int _EnableFinalLightingClamp;

// PerBlock quality tier: when nonzero, ResolveDirect
// samples the radiance atlas at the field pixel nearest each world cell's
// center instead of the dispatch thread's own pixel, so every pixel inside
// one cell reads the identical resolved value - flat per-block shading
// instead of PerPixel's smooth per-texel gradient. Reuses the same cascade
// solve and atlas; only the read position for the final resolve changes.
int _BlockAveraged;

int _CascadeOffset;
int2 _CascadeProbeSize;
int _CascadeProbeSpacing;
int _CascadeDirectionCount;
float2 _CascadeInterval;
float2 _FarCascadeInterval;
int _FarCascadeOffset;
int2 _FarCascadeProbeSize;
int _FarCascadeProbeSpacing;
int _FarCascadeDirectionCount;
int _HasFarCascade;
int _EnableBilinearFix;
int _CascadeEntryCount;
int _CascadeDispatchRowWidth;

SamplerState sampler_LinearClamp;

uint2 PackRadiance(float3 radiance)
{
    return uint2(
        f32tof16(radiance.r) | (f32tof16(radiance.g) << 16),
        f32tof16(radiance.b));
}

float3 UnpackRadiance(uint2 packedRadiance)
{
    return float3(
        f16tof32(packedRadiance.x & 0xffff),
        f16tof32(packedRadiance.x >> 16),
        f16tof32(packedRadiance.y & 0xffff));
}

uint3 PackInterval(float3 radiance, float3 transmittance)
{
    return uint3(
        f32tof16(radiance.r) | (f32tof16(radiance.g) << 16),
        f32tof16(radiance.b) | (f32tof16(transmittance.r) << 16),
        f32tof16(transmittance.g) | (f32tof16(transmittance.b) << 16));
}

float3 UnpackTransmittance(uint3 packedInterval)
{
    return float3(
        f16tof32(packedInterval.y >> 16),
        f16tof32(packedInterval.z & 0xffff),
        f16tof32(packedInterval.z >> 16));
}

float3 TransmissionFromPath(float2 pathLength)
{
    float3 opticalDepth =
        _EmptyExtinctionRgb.rgb * pathLength.x +
        (_SolidExtinctionRgb.rgb * 8.0) * pathLength.y;
    return exp(-opticalDepth);
}

float3 SegmentTransmission(float solid, float physicalLength)
{
    float3 solidExtinction = _SolidExtinctionRgb.rgb * 8.0;
    float3 extinction = lerp(
        _EmptyExtinctionRgb.rgb,
        solidExtinction,
        solid);
    return exp(-extinction * physicalLength);
}

float Max3(float3 value)
{
    return max(value.x, max(value.y, value.z));
}

// Константа направлений для ResolveDirect: на Metal static const внутри
// функции может конфликтовать, объявление до использования обязательно.
static const float2 kResolveDirections4[4] =
{
    float2(0.70710678118, 0.70710678118),
    float2(-0.70710678118, 0.70710678118),
    float2(-0.70710678118, -0.70710678118),
    float2(0.70710678118, -0.70710678118)
};

float2 OutputUv(float2 pixelPosition)
{
    return saturate(pixelPosition / float2(_FieldSize));
}

float InterleavedGradientNoise(float2 pixelCoord)
{
    float3 magic = float3(0.06711056, 0.00583715, 52.9829189);
    return frac(magic.z * frac(dot(pixelCoord, magic.xy)));
}

float3 SampleBounceFiltered(float2 uv)
{
    float2 ts = 1.0 / float2(_BounceSize);

    // 13-tap spatial reconstruction filter:
    // Blurs high-frequency angular jitter into smooth continuous diffuse irradiance.
    float3 col = _BounceInput.SampleLevel(sampler_LinearClamp, uv, 0).rgb * 4.0;

    // Near cross taps (distance 1.25 texels)
    col += _BounceInput.SampleLevel(sampler_LinearClamp, uv + float2(ts.x * 1.25, 0.0), 0).rgb * 2.0;
    col += _BounceInput.SampleLevel(sampler_LinearClamp, uv - float2(ts.x * 1.25, 0.0), 0).rgb * 2.0;
    col += _BounceInput.SampleLevel(sampler_LinearClamp, uv + float2(0.0, ts.y * 1.25), 0).rgb * 2.0;
    col += _BounceInput.SampleLevel(sampler_LinearClamp, uv - float2(0.0, ts.y * 1.25), 0).rgb * 2.0;

    // Diagonal taps (distance 1.25 texels)
    col += _BounceInput.SampleLevel(sampler_LinearClamp, uv + float2(ts.x * 1.25, ts.y * 1.25), 0).rgb;
    col += _BounceInput.SampleLevel(sampler_LinearClamp, uv + float2(-ts.x * 1.25, ts.y * 1.25), 0).rgb;
    col += _BounceInput.SampleLevel(sampler_LinearClamp, uv + float2(ts.x * 1.25, -ts.y * 1.25), 0).rgb;
    col += _BounceInput.SampleLevel(sampler_LinearClamp, uv + float2(-ts.x * 1.25, -ts.y * 1.25), 0).rgb;

    // Far cross taps (distance 2.5 texels)
    col += _BounceInput.SampleLevel(sampler_LinearClamp, uv + float2(ts.x * 2.5, 0.0), 0).rgb;
    col += _BounceInput.SampleLevel(sampler_LinearClamp, uv - float2(ts.x * 2.5, 0.0), 0).rgb;
    col += _BounceInput.SampleLevel(sampler_LinearClamp, uv + float2(0.0, ts.y * 2.5), 0).rgb;
    col += _BounceInput.SampleLevel(sampler_LinearClamp, uv - float2(0.0, ts.y * 2.5), 0).rgb;

    return col * (1.0 / 20.0);
}




// Nearest field pixel to the center of the world cell containing `pixel`.
// Used by the PerBlock tier so every pixel inside one cell reads the same
// atlas probe, regardless of how many field pixels the cell actually spans.
void GetBlockSnappedPixel(int2 pixel, out int2 result)
{
    result = pixel;
    if (_BlockAveraged != 0)
    {
        float safeCellSize = max(_CellSize, 0.0001);
        float2 safeFieldSize = max(float2(_FieldSize), float2(1.0, 1.0));
        float2 regionCellCount = max(_WorldRect.zw / safeCellSize, float2(0.0001, 0.0001));
        float2 cell = floor((float2(pixel) + 0.5) * regionCellCount / safeFieldSize);
        float2 cellCenterFieldPos = (cell + 0.5) * safeFieldSize / regionCellCount;
        result = clamp(int2(floor(cellCenterFieldPos)), int2(0, 0), _FieldSize - 1);
    }

}

float2 MaterialUv(float2 pixelPosition)
{
    float2 uv = OutputUv(pixelPosition);
    if (_MaterialYFlip != 0)
    {
        uv.y = 1.0 - uv.y;
    }

    return uv;
}

float SampleOccupancy(float2 pixelPosition, float mipLevel)
{
    float4 material = 0.0;
    material = _MaterialField.SampleLevel(
        sampler_LinearClamp,
        MaterialUv(pixelPosition),
        mipLevel);
    return material.a;
}

// Occupancy без клампа UV: за пределами поля — 0 (пустота). Нужен для
// автонормалей: на границе карты красноскал (occupancy 1) доходит до края
// поля, и кламп в SampleOccupancy возвращал тот же 1, обнуляя градиент —
// нормали на границе мира не появлялись.
void GetOccupancyUnclamped(float2 pixelPosition, out float occupancy)
{
    occupancy = 0.0;
    bool isInsideField = all(pixelPosition >= 0.0) && all(pixelPosition < float2(_FieldSize));
    if (isInsideField)
    {
        float2 safeFieldSize = max(float2(_FieldSize), float2(1.0, 1.0));
        float2 uv = pixelPosition / safeFieldSize;
        if (_MaterialYFlip != 0)
        {
            uv.y = 1.0 - uv.y;
        }

        occupancy = _MaterialField.SampleLevel(sampler_LinearClamp, uv, 0.0).a;
    }
}

float PathLengthInCells(float2 rayDirection, float pathLengthInPixels)
{
    float2 cellsPerPixel = (_WorldRect.zw / _CellSize) / float2(_FieldSize);
    return length(rayDirection * cellsPerPixel * pathLengthInPixels);
}

void CheckCellSolid(int2 cellCoord, float2 cellsPerPixel, out bool isSolid)
{
    isSolid = false;
    float2 centerPixel = (float2(cellCoord) + 0.5) / cellsPerPixel;
    if (all(centerPixel >= 0.0) && all(centerPixel < float2(_FieldSize)))
    {
        isSolid = (SampleOccupancy(centerPixel, 0.0) >= 0.4);
    }
}

// Blocks sharing a single common vertex (touching diagonally) must not transmit light between them.
void CheckDiagonalStepOccluded(int2 prevCell, int2 currentCell, float2 cellsPerPixel, out bool isOccluded)
{
    isOccluded = false;
    int dx = currentCell.x - prevCell.x;
    int dy = currentCell.y - prevCell.y;
    if (dx != 0 && dy != 0)
    {
        int stepX = clamp(dx, -1, 1);
        int stepY = clamp(dy, -1, 1);
        int2 cornerA = int2(prevCell.x + stepX, prevCell.y);
        int2 cornerB = int2(prevCell.x, prevCell.y + stepY);
        bool solidA = false;
        bool solidB = false;
        CheckCellSolid(cornerA, cellsPerPixel, solidA);
        CheckCellSolid(cornerB, cellsPerPixel, solidB);

        // Только пара углов у ИСХОДНОЙ клетки. Вторая пара, у клетки
        // назначения, стоила ещё двух выборок и срабатывала ровно тогда,
        // когда шаг перепрыгнул клетку — а перепрыгнувший луч прошёл не
        // через названный угол, а мимо. Две выборки за догадку.
        isOccluded = solidA && solidB;
    }
}


// Reads the emission field, which already contains the dynamic sources.
//
// This used to loop over every dynamic light here and accumulate its falloff.
// That loop sat on the hottest path in the whole renderer: the ray march calls
// this once per step, and a solve issues on the order of 238 million steps, so
// a single lamp cost 238M iterations of a length() and a branch - and the price
// scaled linearly with how many lights were on screen. The same falloff is now
// rasterized into _EmissionField once per solve by Hidden/Fodinae/DynamicEmission,
// over a quad the size of the light rather than the size of the world.
float4 SampleEmission(float2 pixelPosition, float mipLevel)
{
    return _EmissionField.SampleLevel(
        sampler_LinearClamp,
        MaterialUv(pixelPosition),
        mipLevel);
}

float4 CalculateAutomaticSurfaceNormal(float2 pixelPosition)
{
    // Сэмплы без клампа: на границе поля (край карты) сосед за пределами
    // считается пустотой, и красноскал даёт градиент occupancy -> нормаль.
    float occupancyLeft = 0.0;
    float occupancyRight = 0.0;
    float occupancyDown = 0.0;
    float occupancyUp = 0.0;
    GetOccupancyUnclamped(pixelPosition - float2(1.0, 0.0), occupancyLeft);
    GetOccupancyUnclamped(pixelPosition + float2(1.0, 0.0), occupancyRight);
    GetOccupancyUnclamped(pixelPosition - float2(0.0, 1.0), occupancyDown);
    GetOccupancyUnclamped(pixelPosition + float2(0.0, 1.0), occupancyUp);
    float2 occupancyGradient = float2(
        occupancyRight - occupancyLeft,
        occupancyUp - occupancyDown);
    float gradientLength = length(occupancyGradient);
    float strength = saturate(gradientLength * 2.0);
    float3 surfaceNormal = float3(0.0, 0.0, 0.0);
    if (gradientLength > 0.05)
    {
        surfaceNormal = float3(-occupancyGradient / gradientLength, 0.0);
    }

    return float4(surfaceNormal, strength);
}

float4 SampleAutomaticSurfaceNormal(float2 pixelPosition)
{
    int2 pixel = clamp(
        int2(floor(pixelPosition)),
        int2(0, 0),
        _FieldSize - 1);
    return _AutomaticNormalInput.Load(int3(pixel.x, pixel.y, 0));
}

float SurfaceLambert(
    float4 normalData,
    float2 lightDirection)
{
    float3 surfaceNormal = normalData.xyz;
    float normalStrength = saturate(normalData.w);
    float directionalResponse = saturate(dot(
        surfaceNormal,
        float3(lightDirection, 0.0)));
    float normalMask = step(0.001, normalStrength);
    return lerp(1.0, directionalResponse, normalStrength * normalMask);
}

void TraceRadianceSegment(
    float2 receiverOrigin,
    float2 segmentStart,
    float2 segmentEnd,
    int hasFollowingInterval,
    out float3 radiance,
    out float3 transmittance)
{
    float2 segment = segmentEnd - segmentStart;
    float intervalLength = max(length(segment), 0.0001);
    float2 rayDirection = segment / intervalLength;
    int stepCount = clamp(
        int(ceil(intervalLength)),
        1,
        min(_MaximumIntervalSteps, MAX_INTERVAL_STEPS));
    float stepLength = intervalLength / float(stepCount);
    float physicalStepLength = PathLengthInCells(rayDirection, stepLength);
    float samplingMip = max(0.0, log2(max(stepLength, 1.0)));
    float2 cellsPerPixel = (_WorldRect.zw / _CellSize) / float2(_FieldSize);
    int2 prevCell = int2(floor(segmentStart * cellsPerPixel));
    radiance = 0.0;
    transmittance = 1.0;

    [loop]
    for (int stepIndex = 0; stepIndex < MAX_INTERVAL_STEPS; stepIndex++)
    {
        if (stepIndex >= stepCount || Max3(transmittance) <= _MinimumTransmission)
        {
            break;
        }

        float2 samplePosition = segmentStart + rayDirection *
            ((float(stepIndex) + 0.5) * stepLength);
        bool outside = any(samplePosition < 0.0) ||
            any(samplePosition >= float2(_FieldSize));
        if (outside)
        {
            if (hasFollowingInterval == 0)
            {
                break;
            }

            transmittance *= SegmentTransmission(0.0, physicalStepLength);
            continue;
        }

        int2 currentCell = int2(floor(samplePosition * cellsPerPixel));
        // Угловой тест только на нулевом мипе. Выше занятость уже усреднена
        // по нескольким клеткам, отдельного угла в ней нет — тест ничего не
        // решает, а выборки берёт. Это внутренний цикл каскадного решения,
        // самый горячий в движке: две лишние выборки здесь стоят кадра.
        if (samplingMip <= 0.0)
        {
            bool diagonalOccluded = false;
            CheckDiagonalStepOccluded(prevCell, currentCell, cellsPerPixel, diagonalOccluded);
            if (diagonalOccluded)
            {
                transmittance = 0.0;
                break;
            }
        }

        prevCell = currentCell;

        float occupancy = saturate(SampleOccupancy(samplePosition, samplingMip));
        float solid = occupancy;
        float4 emission = SampleEmission(samplePosition, 0.0);
        float3 emittedRadiance =
            max(emission.rgb, 0.0) * physicalStepLength * _EmissionScale;
        radiance += transmittance * emittedRadiance;
        transmittance *= SegmentTransmission(solid, physicalStepLength);
    }
}

[numthreads(64, 1, 1)]
void SolveCascade(uint3 dispatchId : SV_DispatchThreadID)
{
    uint localIndex = dispatchId.x + dispatchId.y * (uint)_CascadeDispatchRowWidth;
    if (localIndex >= (uint)_CascadeEntryCount)
    {
        return;
    }

    uint directionIndex = localIndex % (uint)_CascadeDirectionCount;
    uint probeIndex = localIndex / (uint)_CascadeDirectionCount;
    int2 probe = int2(
        probeIndex % (uint)_CascadeProbeSize.x,
        probeIndex / (uint)_CascadeProbeSize.x);
    float2 origin = (float2(probe) + 0.5) * _CascadeProbeSpacing;
    float angle = (float(directionIndex) + 0.5) * PI2 /
        float(_CascadeDirectionCount);
    float raySine;
    float rayCosine;
    sincos(angle, raySine, rayCosine);
    float2 rayDirection = float2(rayCosine, raySine);
    float2 intervalStart = origin + rayDirection * _CascadeInterval.x;
    float2 intervalEnd = origin + rayDirection * _CascadeInterval.y;
    float3 radiance = 0.0;
    float3 transmittance = 1.0;
    if (_EnableBilinearFix == 0 || _HasFarCascade == 0)
    {
        TraceRadianceSegment(
            origin,
            intervalStart,
            intervalEnd,
            _HasFarCascade,
            radiance,
            transmittance);
    }

    if (_HasFarCascade != 0)
    {
        // Every cascade stores the next contiguous radial interval from the
        // same receiver position. Interpolate the coarser probe field at this
        // probe's position; offsetting the lookup to the near interval end
        // would apply the far cascade's interval start twice and leave gaps.
        float2 farProbePosition = origin / float(_FarCascadeProbeSpacing) - 0.5;
        int2 farProbeBase = int2(floor(farProbePosition));
        float2 farProbeBlend = frac(farProbePosition);
        uint directionBranchCount = clamp(
            (uint)_FarCascadeDirectionCount / (uint)_CascadeDirectionCount,
            1u,
            4u);
        uint farDirectionBase = directionIndex * directionBranchCount;
        float3 farRadiance = 0.0;
        float3 farTransmittance = 0.0;
        float3 fixedRadiance = 0.0;
        float3 fixedTransmittance = 0.0;

        [loop]
        for (uint farDirectionBranch = 0u; farDirectionBranch < directionBranchCount;
            farDirectionBranch++)
        {
            uint farDirection = (farDirectionBase + farDirectionBranch) %
                (uint)_FarCascadeDirectionCount;

            [unroll]
            for (int farY = 0; farY < 2; farY++)
            {
                [unroll]
                for (int farX = 0; farX < 2; farX++)
                {
                    int2 farProbe = clamp(
                        farProbeBase + int2(farX, farY),
                        int2(0, 0),
                        _FarCascadeProbeSize - 1);
                    int farIndex = _FarCascadeOffset +
                        (farProbe.y * _FarCascadeProbeSize.x + farProbe.x) *
                        _FarCascadeDirectionCount + (int)farDirection;
                    float probeWeight =
                        (farX == 0 ? 1.0 - farProbeBlend.x : farProbeBlend.x) *
                        (farY == 0 ? 1.0 - farProbeBlend.y : farProbeBlend.y) /
                        float(directionBranchCount);
                    uint3 farPackedInterval = _RadianceAtlas[farIndex];
                    float3 sampledFarRadiance =
                        UnpackRadiance(farPackedInterval.xy);
                    float3 sampledFarTransmittance =
                        UnpackTransmittance(farPackedInterval);
                    if (_EnableBilinearFix != 0)
                    {
                        float farAngle = (float(farDirection) + 0.5) * PI2 /
                            float(_FarCascadeDirectionCount);
                        float farSine;
                        float farCosine;
                        sincos(farAngle, farSine, farCosine);
                        float2 farDirectionVector = float2(farCosine, farSine);
                        float2 farOrigin =
                            (float2(farProbe) + 0.5) * _FarCascadeProbeSpacing;
                        float2 childIntervalStart = farOrigin +
                            farDirectionVector * _FarCascadeInterval.x;
                        float3 childNearRadiance;
                        float3 childNearTransmittance;
                        TraceRadianceSegment(
                            origin,
                            intervalStart,
                            childIntervalStart,
                            1,
                            childNearRadiance,
                            childNearTransmittance);
                        fixedRadiance += (childNearRadiance +
                            childNearTransmittance * sampledFarRadiance) * probeWeight;
                        fixedTransmittance +=
                            childNearTransmittance * sampledFarTransmittance * probeWeight;
                    }
                    else
                    {
                        farRadiance += sampledFarRadiance * probeWeight;
                        farTransmittance += sampledFarTransmittance * probeWeight;
                    }
                }
            }
        }

        if (_EnableBilinearFix != 0)
        {
            radiance = fixedRadiance;
            transmittance = fixedTransmittance;
        }
        else
        {
            // Eq. 7 from Holographic Radiance Cascades: merge the near
            // interval with linearly interpolated far radiance/transmittance.
            radiance += transmittance * farRadiance;
            transmittance *= farTransmittance;
        }
    }

    int atlasIndex = _CascadeOffset + (int)localIndex;
    _RadianceAtlas[atlasIndex] = PackInterval(
        radiance,
        transmittance);
}

[numthreads(8, 8, 1)]
void SolveAutomaticNormals(uint3 dispatchId : SV_DispatchThreadID)
{
    if (any(dispatchId.xy >= (uint2)_FieldSize))
    {
        return;
    }

    _AutomaticNormalField[dispatchId.xy] = CalculateAutomaticSurfaceNormal(
        float2(dispatchId.xy) + 0.5);
}

[numthreads(8, 8, 1)]
void ResolveDirect(uint3 dispatchId : SV_DispatchThreadID)
{
    if (any(dispatchId.xy >= (uint2)_FieldSize))
    {
        return;
    }

    int2 pixel = int2(dispatchId.xy);
    int2 samplePixel = pixel;
    GetBlockSnappedPixel(pixel, samplePixel);
    int probeIndex = samplePixel.y * _FieldSize.x + samplePixel.x;
    float3 radiance = 0.0;
    float4 normalData = SampleAutomaticSurfaceNormal(float2(samplePixel) + 0.5);

    if (_DebugView == 5)
    {
        float3 localTransmission = 0.0;
        float2 origin = float2(pixel) + 0.5;
        float2 regionCellCount = _WorldRect.zw / _CellSize;
        float2 cellsPerPixel = regionCellCount / float2(_FieldSize);
        int2 receiverCell = int2(floor(origin * cellsPerPixel));
        bool startsInSolid = SampleOccupancy(origin, 0.0) >= 0.5;

        [loop]
        for (int debugDirection = 0; debugDirection < 32; debugDirection++)
        {
            float debugAngle = (float(debugDirection) + 0.5) * PI2 / 32.0;
            float debugSine;
            float debugCosine;
            sincos(debugAngle, debugSine, debugCosine);
            float2 debugRay = float2(debugCosine, debugSine);
            float pixelsPerCell = length(float2(_FieldSize) / regionCellCount * debugRay);
            float debugStepPixels =
                (_TransmittanceDebugDistanceCells * pixelsPerCell) / 16.0;
            float debugStepCells = PathLengthInCells(debugRay, debugStepPixels);
            float2 debugPath = 0.0;
            int2 prevCell = receiverCell;

            [unroll]
            for (int debugStep = 0; debugStep < 16; debugStep++)
            {
                float2 samplePosition = origin + debugRay *
                    ((float(debugStep) + 0.5) * debugStepPixels);
                if (any(samplePosition < 0.0) ||
                    any(samplePosition >= float2(_FieldSize)))
                {
                    debugPath.x += debugStepCells;
                    continue;
                }

                int2 currentCell = int2(floor(samplePosition * cellsPerPixel));
                bool diagonalOccluded = false;
                CheckDiagonalStepOccluded(prevCell, currentCell, cellsPerPixel, diagonalOccluded);
                if (diagonalOccluded)
                {
                    debugPath.y += float(16 - debugStep) * debugStepCells;
                    break;
                }

                prevCell = currentCell;

                float occupancy = saturate(SampleOccupancy(samplePosition, 0.0));
                debugPath += float2(1.0 - occupancy, occupancy) * debugStepCells;
            }

            localTransmission += TransmissionFromPath(debugPath);
        }

        _DirectTexture[pixel] = float4(localTransmission / 32.0, 1.0);
        return;
    }

    [unroll]
    for (int direction = 0; direction < 4; direction++)
    {
        int atlasIndex = _CascadeOffset + probeIndex * 4 + direction;
        uint3 packedInterval = _RadianceAtlas[atlasIndex];
        radiance += UnpackRadiance(packedInterval.xy) * SurfaceLambert(
            normalData,
            kResolveDirections4[direction]);
    }

    float3 directOutput = radiance * 0.25;
    _DirectTexture[pixel] = float4(directOutput, 1.0);
}

[numthreads(8, 8, 1)]
void SolveDiffuseBounce(uint3 dispatchId : SV_DispatchThreadID)
{
    if (any(dispatchId.xy >= (uint2)_BounceSize))
    {
        return;
    }

    int2 pixel = int2(dispatchId.xy);
    float bounceStrength = (_DebugView == 9) ? max(_BounceStrength, 1.0) : _BounceStrength;
    if (_EnableDiffuseBounce == 0 && _DebugView != 9)
    {
        _BounceTexture[pixel] = 0.0;
        return;
    }

    if (bounceStrength <= 0.0001)
    {
        _BounceTexture[pixel] = 0.0;
        return;
    }

    float2 fieldPosition = (float2(pixel) + 0.5) * float2(_FieldSize) / float2(_BounceSize);

    float4 centerMat = _MaterialField.SampleLevel(sampler_LinearClamp, MaterialUv(fieldPosition), 0);
    float centerSolid = saturate(centerMat.a);

    float centerMax = max(centerMat.r, max(centerMat.g, centerMat.b));
    float3 centerAlbedo = centerMax > 0.04
        ? (centerMat.rgb / centerMax) * max(centerMax, 0.4)
        : float3(0.4, 0.38, 0.36);
    centerAlbedo = min(centerAlbedo, 0.75);

    float2 cellsPerPixel = (_WorldRect.zw / _CellSize) / float2(_FieldSize);
    float pixelsPerCell = 1.0 / max(cellsPerPixel.x, 0.0001);

    // Screen-space angular jitter: eliminates discrete directional banding by rotating
    // the 8 directions per-pixel. The 13-tap reconstruction filter smooths this into continuous GI.
    float jitter = InterleavedGradientNoise(float2(pixel));
    float baseAngle = jitter * (PI2 / 8.0);

    float3 gatheredBounce = 0.0;
    float totalWeight = 0.0;

    [unroll]
    for (int d = 0; d < 8; d++)
    {
        float angle = baseAngle + float(d) * (PI2 / 8.0);
        float raySin;
        float rayCos;
        sincos(angle, raySin, rayCos);
        float2 rayDir = float2(rayCos, raySin);

        float2 prevPos = fieldPosition;
        int2 prevCell = int2(floor(fieldPosition * cellsPerPixel));

        [unroll]
        for (int stepIdx = 1; stepIdx <= 3; stepIdx++)
        {
            float distCells = float(stepIdx) * 1.35;
            float2 samplePos = fieldPosition + rayDir * (distCells * pixelsPerCell);
            if (any(samplePos < 0.0) || any(samplePos >= float2(_FieldSize)))
            {
                break;
            }

            int2 currentCell = int2(floor(samplePos * cellsPerPixel));
            bool diagonalOccluded = false;
            CheckDiagonalStepOccluded(prevCell, currentCell, cellsPerPixel, diagonalOccluded);
            if (diagonalOccluded)
            {
                break;
            }

            prevCell = currentCell;

            float4 mat = _MaterialField.SampleLevel(sampler_LinearClamp, MaterialUv(samplePos), 0);
            float solid = saturate(mat.a);

            if (solid > 0.2) // Struck an illuminated solid surface
            {
                // Robust direct sampling: max between surface and air immediately in front of it
                float2 uvSample = OutputUv(samplePos);
                float2 uvPrev = OutputUv(prevPos);
                float3 incident = max(
                    _DirectInput.SampleLevel(sampler_LinearClamp, uvSample, 0).rgb +
                    _StaticDirectInput.SampleLevel(sampler_LinearClamp, uvSample, 0).rgb,
                    _DirectInput.SampleLevel(sampler_LinearClamp, uvPrev, 0).rgb +
                    _StaticDirectInput.SampleLevel(sampler_LinearClamp, uvPrev, 0).rgb);

                float mCh = max(mat.r, max(mat.g, mat.b));
                float3 albedo = mCh > 0.04
                    ? (mat.rgb / mCh) * max(mCh, 0.4)
                    : float3(0.4, 0.38, 0.36);
                albedo = min(albedo, 0.75);

                float distanceFalloff = 1.0 / (1.0 + distCells * 0.4);
                float w = solid * distanceFalloff;
                gatheredBounce += incident * albedo * w;
                totalWeight += w;
                break; // Opaque surface occludes further ray travel
            }

            prevPos = samplePos;
        }
    }

    // Direct surface reflection at receiver (if on or near a solid boundary)
    float2 uvCenter = OutputUv(fieldPosition);
    float3 directCenter = _DirectInput.SampleLevel(sampler_LinearClamp, uvCenter, 0).rgb +
                          _StaticDirectInput.SampleLevel(sampler_LinearClamp, uvCenter, 0).rgb;

    // Find brightest direct light among immediate neighbors (air in front of block)
    float3 directAdjacent = max(
        max(
            _DirectInput.SampleLevel(sampler_LinearClamp, OutputUv(fieldPosition + float2(pixelsPerCell, 0.0)), 0).rgb +
            _StaticDirectInput.SampleLevel(sampler_LinearClamp, OutputUv(fieldPosition + float2(pixelsPerCell, 0.0)), 0).rgb,
            _DirectInput.SampleLevel(sampler_LinearClamp, OutputUv(fieldPosition - float2(pixelsPerCell, 0.0)), 0).rgb +
            _StaticDirectInput.SampleLevel(sampler_LinearClamp, OutputUv(fieldPosition - float2(pixelsPerCell, 0.0)), 0).rgb),
        max(
            _DirectInput.SampleLevel(sampler_LinearClamp, OutputUv(fieldPosition + float2(0.0, pixelsPerCell)), 0).rgb +
            _StaticDirectInput.SampleLevel(sampler_LinearClamp, OutputUv(fieldPosition + float2(0.0, pixelsPerCell)), 0).rgb,
            _DirectInput.SampleLevel(sampler_LinearClamp, OutputUv(fieldPosition - float2(0.0, pixelsPerCell)), 0).rgb +
            _StaticDirectInput.SampleLevel(sampler_LinearClamp, OutputUv(fieldPosition - float2(0.0, pixelsPerCell)), 0).rgb));

    float3 directOnSurface = max(directCenter, directAdjacent);
    float3 surfaceGlow = directOnSurface * centerAlbedo;

    float3 scatteredInAir = (totalWeight > 0.001)
        ? (gatheredBounce / max(totalWeight, 1.0)) * 2.0
        : 0.0;

    float3 finalBounce = lerp(scatteredInAir, surfaceGlow, centerSolid) * bounceStrength;
    _BounceTexture[pixel] = float4(finalBounce, 1.0);
}

[numthreads(8, 8, 1)]
void CompositeLighting(uint3 dispatchId : SV_DispatchThreadID)
{
    if (any(dispatchId.xy >= (uint2)_FieldSize))
    {
        return;
    }

    int2 pixel = int2(dispatchId.xy);
    float2 uv = (float2(pixel) + 0.5) / float2(_FieldSize);
    int2 materialPixel = pixel;
    if (_MaterialYFlip != 0)
    {
        materialPixel.y = _FieldSize.y - 1 - materialPixel.y;
    }

    float4 material = _MaterialField.Load(int3(materialPixel.x, materialPixel.y, 0)).rgba;
    float4 emission = _EmissionField.Load(int3(materialPixel.x, materialPixel.y, 0)).rgba;
    if (_DebugView == 1) // Occupancy
    {
        _Result[pixel] = float4(material.aaa, 1.0);
        return;
    }

    if (_DebugView == 2) // Albedo
    {
        _Result[pixel] = float4(material.rgb, 1.0);
        return;
    }

    if (_DebugView == 3) // Emission
    {
        _Result[pixel] = float4(emission.rgb, 1.0);
        return;
    }

    if (_DebugView == 4) // Normals
    {
        float4 normalData = SampleAutomaticSurfaceNormal(float2(pixel) + 0.5);
        float3 normalVisual = normalData.w > 0.05
            ? (normalData.xyz * 0.5 + 0.5)
            : 0.0;
        _Result[pixel] = float4(normalVisual, 1.0);
        return;
    }

    float4 dynamicDirect = _DirectInput.Load(int3(pixel.x, pixel.y, 0)).rgba;
    float4 staticDirect = _StaticDirectInput.Load(int3(pixel.x, pixel.y, 0)).rgba;

    if (_DebugView == 5) // Transmission (pure transmittance without static contamination)
    {
        _Result[pixel] = float4(dynamicDirect.rgb, 1.0);
        return;
    }

    if (_DebugView == 6) // StaticDirect
    {
        _Result[pixel] = float4(staticDirect.rgb, 1.0);
        return;
    }

    if (_DebugView == 7) // DynamicDirect
    {
        _Result[pixel] = float4(dynamicDirect.rgb, 1.0);
        return;
    }

    float4 combinedDirect = dynamicDirect + staticDirect;

    if (_DebugView == 8) // DirectRadiance (combined)
    {
        _Result[pixel] = float4(combinedDirect.rgb, 1.0);
        return;
    }

    float3 bounce = SampleBounceFiltered(uv);

    if (_DebugView == 9) // DiffuseBounce
    {
        _Result[pixel] = float4(bounce, 1.0);
        return;
    }

    float3 bounceTerm = _EnableDiffuseBounce != 0 ? bounce : 0.0;
    float3 result = _AmbientColor.rgb + bounceTerm + combinedDirect.rgb;

    if (_DebugView == 10) // Exposure (false-color zebras)
    {
        float maximumLight = max(_MaximumLightMultiplier, 0.0001);
        float peak = Max3(result);
        float3 falseColor = float3(0.0, 0.0, 0.0);
        if (peak > maximumLight)
        {
            // Overexposed / clipped -> bright red
            falseColor = float3(1.0, 0.1, 0.1);
        }
        else if (peak > 1.0)
        {
            // High dynamic range (1.0 to maximumLight) -> yellow-orange
            float t = (peak - 1.0) / max(maximumLight - 1.0, 0.0001);
            falseColor = lerp(float3(0.3, 0.9, 0.2), float3(1.0, 0.7, 0.0), saturate(t));
        }
        else if (peak > 0.05)
        {
            // Well-exposed (< 1.0) -> green gradient
            float t = (peak - 0.05) / 0.95;
            falseColor = lerp(float3(0.05, 0.3, 0.1), float3(0.3, 0.9, 0.2), saturate(t));
        }
        else
        {
            // Deep shadow (< 0.05) -> dark blue
            float t = peak / 0.05;
            falseColor = lerp(float3(0.02, 0.04, 0.15), float3(0.05, 0.3, 0.1), saturate(t));
        }

        _Result[pixel] = float4(falseColor, 1.0);
        return;
    }

    float3 output = max(result, 0.0);
    if (_DebugView == 0 && _EnableFinalLightingClamp != 0)
    {
        float maximumLight = max(_MaximumLightMultiplier, 0.0001);
        float outputPeak = Max3(output);
        if (outputPeak > maximumLight)
        {
            // Preserve chromaticity: scale RGB together instead of clipping
            // channels independently and shifting the light color.
            output *= maximumLight / outputPeak;
        }
    }
    _Result[pixel] = float4(output, 1.0);
}
