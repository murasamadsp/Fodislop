#ifndef FODINAE_COLOR_GRADING_INCLUDED
#define FODINAE_COLOR_GRADING_INCLUDED

// ============================================================================
// Цветовой конвейер: лог-кодирование, творческий грейд, кривая вывода.
// ============================================================================
//
// ЗАЧЕМ ОТДЕЛЬНЫМ ФАЙЛОМ. PostProcess.compute занят кадром: блум, оптика,
// зерно, композит. Цвет — другая работа и другой словарь, и держать их в одном
// файле значило бы, что правку кривой надо искать между ветками анаморфных
// лучей.
//
// ПОРЯДОК ОПЕРАЦИЙ. Он не произволен и повторяет устройство настоящего
// цветового конвейера:
//
//   сцен-линейный кадр
//     -> экспозиция, баланс белого        линейные операции: они физичны,
//                                          это свойства съёмки, а не вкуса
//     -> лог-кодирование
//     -> CDL (slope/offset/power)         творческий грейд: он перцептивен,
//     -> контраст                          и потому живёт в логе
//     -> лог-декодирование
//     -> фотометрическая насыщенность      линейные веса Rec.709 без сдвига оттенка
//     -> кривая вывода (DRT)
//     -> кодирование дисплея
//
// Шаг в логарифме равномерен по восприятию, в линейном — нет: одна и та же
// прибавка контраста в линейном означала бы разное в тенях и в светах.

// ----------------------------------------------------------------------------
// Слой 1: линейные операции
// ----------------------------------------------------------------------------

// Баланс белого через LMS — пространство откликов колбочек глаза. Умножать
// надо именно там: в RGB множитель по каналам меняет и оттенок, а не только
// температуру, потому что каналы RGB не соответствуют ничему в зрении.
//
// Температура и оттенок здесь — не кельвины, а сдвиг в [-100, 100]
// относительно точки съёмки: крутят «холоднее/теплее», а не выставляют
// абсолютное значение.
float3 WhiteBalanceCoefficients(float temperature, float tint)
{
    float t1 = temperature / 65.0;
    float t2 = tint / 65.0;

    // Отрицательный сдвиг (в холод) уводит по x сильнее положительного:
    // планковский локус несимметричен, и равные шаги в кельвинах дают
    // неравные шаги в цветности.
    float x = 0.31271 - t1 * (t1 < 0.0 ? 0.1 : 0.05);
    float standardY = 2.87 * x - 3.0 * x * x - 0.27509507;
    float y = standardY + t2 * 0.05;

    float3 w1 = float3(0.949237, 1.03542, 1.08728);
    float divisor = max(y, 1e-5);
    float3 xyz = float3(x / divisor, 1.0, (1.0 - x - y) / divisor);
    float3 w2 = float3(
        dot(xyz, float3( 0.7328, 0.4296, -0.1624)),
        dot(xyz, float3(-0.7036, 1.6975,  0.0061)),
        dot(xyz, float3( 0.0030, 0.0136,  0.9834)));

    return w1 / max(w2, 1e-5);
}

float3 ApplyWhiteBalance(float3 color, float3 lmsCoefficients)
{
    // Пара обязана быть взаимно обратной: это одно преобразование туда и
    // обратно, и расхождение в любом знаке даёт постоянный цветовой сдвиг
    // даже при нейтральном балансе. Суммы строк здесь НЕ равны единице, и это
    // правильно: LMS не сохраняет белое покомпонентно — его сохраняет цепочка
    // целиком.
    const float3x3 toLms = float3x3(
        3.90405e-1, 5.49941e-1, 8.92632e-3,
        7.08416e-2, 9.63172e-1, 1.35775e-3,
        2.31082e-2, 1.28021e-1, 9.36245e-1);
    const float3x3 fromLms = float3x3(
         2.85847e+0, -1.62879e+0, -2.48910e-2,
        -2.10182e-1,  1.15820e+0,  3.24281e-4,
        -4.18120e-2, -1.18169e-1,  1.06867e+0);

    float3 lms = mul(toLms, color);
    lms *= lmsCoefficients;
    return mul(fromLms, lms);
}

// ----------------------------------------------------------------------------
// Слой 2: лог-кодирование
// ----------------------------------------------------------------------------
//
// Своё, а не ACEScct и не лог AgX: обе чужие шкалы привязаны к чужим белым
// точкам и чужим примарам, и брать из них только кодирование значит тащить
// привязку, которой в проекте нет. Здесь шкала объявлена явно — стопы
// относительно средне-серого, нормированные в [0, 1].
//
// FodinaeSceneToeStops стопов ниже серого и FodinaeSceneHeadStops выше него.
// Диапазон выбран под сцену, а не под кинонегатив: 10 стопов вниз это
// серый/1024, 6.5 вверх — серый*90, чего хватает и на неон, и на тени.

static const float FodinaeMidGrey = 0.18;
static const float FodinaeSceneToeStops = 10.0;
static const float FodinaeSceneHeadStops = 6.5;
static const float FodinaeSceneStops = FodinaeSceneToeStops + FodinaeSceneHeadStops;

float3 FodinaeLogEncode(float3 linearColor)
{
    float3 stops = log2(max(linearColor, 1e-7) / FodinaeMidGrey);
    // Do not clamp here. A neutral encode/decode round-trip must preserve HDR
    // values outside the nominal working range; clipping belongs to the
    // display transform, not to the grading space.
    return (stops + FodinaeSceneToeStops) / FodinaeSceneStops;
}

float3 FodinaeLogDecode(float3 logColor)
{
    float3 stops = logColor * FodinaeSceneStops - FodinaeSceneToeStops;
    return exp2(stops) * FodinaeMidGrey;
}

// ----------------------------------------------------------------------------
// Слой 3: ASC CDL — стандарт обмена грейдом
// ----------------------------------------------------------------------------
//
// out = (in * slope + offset) ^ power, по каналам. Формулу описал American
// Society of Cinematographers, её понимает любой инструмент цветокоррекции, и
// грейд в этом виде вывозится файлом .cdl.
//
// Соответствие привычным словам: slope — усиление (gain), offset — подъём
// (lift), power — гамма средних тонов.
float3 ApplyCdl(float3 color, float3 slope, float3 offset, float3 power)
{
    float3 graded = color * slope + offset;
    // Отрицательное основание в дробной степени даёт NaN, и один такой пиксель
    // расползается по кадру временным накоплением. Но при power == 1 clamp не
    // нужен и вреден: нейтральный CDL обязан сохранить лог-значения ниже нуля,
    // иначе глубокие тени прижимаются к нижней границе рабочего диапазона.
    float3 powered = pow(max(graded, 0.0), max(power, 1e-3));
    float3 unitPower = 1.0 - step(1e-5, abs(power - 1.0));
    return lerp(powered, graded, unitPower);
}

float3 ApplySaturation(float3 color, float saturation, float3 lumaWeights)
{
    float luma = dot(color, lumaWeights);
    return lerp(float3(luma, luma, luma), color, saturation);
}

float3 ApplyContrast(float3 color, float contrast, float pivot)
{
    return (color - pivot) * (1.0 + contrast) + pivot;
}

// ----------------------------------------------------------------------------
// Слой 4: кривая вывода
// ----------------------------------------------------------------------------
//
// ПОЧЕМУ СВОЯ. Восстановленное из истории приближение AgX было сломано и
// потому удалено; чужой полином, подогнанный к чужой сигмоиде, чинить вслепую
// нечем — его параметры ничего не значат по отдельности. Эталонный ACES из
// пакета Core рабочий, но он навязывает свою цветовую науку целиком: примары
// AP0/AP1, RRT со «сладкими» модулями (glow, red modifier) и ODT под комнату
// кинозала. Это не настройка вида, а чужой вид.
//
// Здесь кривая задана параметрами, каждый из которых что-то значит.
//
// УСТРОЙСТВО. Три решения, и все три — против известных дефектов:
//
// 1. КРИВАЯ ПРИМЕНЯЕТСЯ К НОРМЕ, А НЕ К КАНАЛАМ ПОРОЗНЬ. Поканальный тонмап
//    сдвигает оттенок тем сильнее, чем ярче пиксель: у насыщенного оранжевого
//    красный канал упирается в плечо раньше зелёного, и оранжевое уезжает в
//    жёлтое. Это ровно тот дефект, которым знаменит ACES. Здесь берётся норма
//    max(r,g,b), кривая считается ОДИН раз, и результат возвращается
//    масштабированием — цветность при этом сохраняется точно.
//
// 2. КРИВАЯ АСИМПТОТИЧЕСКАЯ, ОТСЕЧКИ НЕТ НИГДЕ. Выход стремится к единице, но
//    не достигает её ни при какой входной яркости. Поэтому «плоских белых
//    пятен» не бывает по построению, а не по удачному подбору чисел.
//    Поскольку rgb/norm <= 1, ни один канал не может превысить норму, и
//    выход гарантированно лежит в [0, 1).
//
// 3. КРИВАЯ ВОЗВРАЩАЕТ ЛИНЕЙНОЕ. Выход сразу display-linear, и обратной
//    линеаризации не требуется. Это не мелочь: прежний AgX выдавал
//    display-encoded значение, которое URP кодировал ВТОРОЙ раз при финальном
//    блите, и чинилось это возведением в степень гаммы внутри тонмапа —
//    шагом, который надо было не забыть. Здесь забывать нечего.
//
// ФОРМА. Асимметричная алгебраическая сигмоида в стопах:
//
//     yStops = t / (1 + |t/h|^p)^(1/p),   t = slope * x
//
// где x — стопы входа относительно серого, h — сколько стопов ВЫХОДА есть в
// запасе с этой стороны от серого. При x -> +inf выражение стремится к h,
// то есть выход стремится к greyOut * 2^h; головной запас берётся ровно
// таким, чтобы этот предел равнялся единице.
//
// Параметры и что они значат:
//   slope          наклон в точке серого — контраст. 1.0 нейтрально.
//   shoulderPower  резкость плеча. Ниже трёх кадр молочный: света подходят к
//                  белому так медленно, что до 0.98 нужны десятки стопов.
//   toePower       резкость носка. Держится ниже плеча: у плёнки носок
//                  положе, и резкий носок обрубает тени.
//   toeStops       сколько стопов ВЫХОДА отведено под тени. Больше — глубже
//                  чёрное.
//
// Носок и плечо описаны РАЗНЫМИ показателями намеренно: одним числом обе
// стороны не задаются, а требования к ним противоположны — плечо должно
// сходиться быстро, носок мягко.
//
// В точке серого обе ветви дают ноль и одинаковую производную slope, то есть
// стык C1-непрерывен. Вторая производная терпит разрыв, потому что запасы и
// показатели сверху и снизу различаются; на глаз это не видно, так как разрыв
// приходится ровно на середину, где кривая почти прямая.

float FodinaeToneCurve(
    float linearValue, float greyOut, float slope,
    float shoulderPower, float toePower, float toeStops)
{
    // Стопы относительно средне-серого сцены.
    float x = log2(max(linearValue, 1e-7) / FodinaeMidGrey);

    // Головной запас: столько стопов выхода от серого до единицы. Считается
    // из greyOut, а не задаётся отдельно, — иначе белая точка и серая точка
    // могли бы разойтись, и кривая перестала бы попадать в единицу.
    float headStops = -log2(max(greyOut, 1e-4));

    bool above = x >= 0.0;
    float h = above ? headStops : toeStops;
    float p = max(above ? shoulderPower : toePower, 1e-3);

    float t = slope * x;
    float normalized = abs(t) / max(h, 1e-4);
    float yStops = t / pow(1.0 + pow(normalized, p), 1.0 / p);

    return greyOut * exp2(yStops);
}

// Уход в белое. Настоящий дисплей не умеет показать насыщенный цвет яркостью
// в белую точку: чем ближе к единице, тем меньше остаётся места под размах
// каналов. Без этого блока яркий неон упирается в потолок, сохраняя полную
// насыщенность, и читается плоской цветной заливкой, а не источником света.
//
// Сила ухода растёт степенью от яркости выхода: тени и середина не трогаются
// вовсе, обесцвечиваются только подходы к белому.
float3 FodinaePathToWhite(float3 color, float luminanceOut, float amount, float power)
{
    float blend = saturate(pow(saturate(luminanceOut), max(power, 1e-3))) * saturate(amount);
    return lerp(color, float3(luminanceOut, luminanceOut, luminanceOut), blend);
}

// Полный переход: сцен-линейное -> display-linear.
float3 FodinaeDisplayTransform(
    float3 color,
    float whitePoint,
    float greyOut,
    float slope,
    float shoulderPower,
    float toePower,
    float toeStops,
    float pathToWhiteAmount,
    float pathToWhitePower)
{
    color = max(color, 0.0) / max(whitePoint, 1e-4);

    // Норма — максимум по каналам, а не яркость: по яркости насыщенные цвета
    // считались бы тусклее, чем они есть, и получали бы меньше сжатия, чем им
    // нужно, то есть выбивались бы из кадра.
    float norm = max(color.r, max(color.g, color.b));

    // ОДНА ТОЧКА ВЫХОДА, и это не стиль. Раньше здесь стоял ранний return для
    // чёрного пикселя, и при трансляции в Metal компилятор не доказывал, что
    // возвращаемое значение инициализировано на всех путях: предупреждение
    // «use of potentially uninitialized variable». Заранее заданный ноль
    // снимает вопрос, а заодно и есть верный ответ для нулевой нормы — делить
    // на неё нельзя.
    float3 result = float3(0.0, 0.0, 0.0);
    if (norm >= 1e-7)
    {
        float mapped = FodinaeToneCurve(norm, greyOut, slope, shoulderPower, toePower, toeStops);

        // Масштабирование по отношению: цветность сохраняется точно, потому
        // что все три канала делятся на одно и то же число. Записано именно
        // отдельной строкой — этот вид стережёт checkDisplayTransform, и он же
        // читается как утверждение «кривая применена к норме, а не к каналам».
        result = color * (mapped / norm);
        result = FodinaePathToWhite(result, mapped, pathToWhiteAmount, pathToWhitePower);
    }

    return result;
}

// ----------------------------------------------------------------------------
// Слой 4: выходной гамут
// ----------------------------------------------------------------------------
//
// ЗАЧЕМ. Кадр считается в примарах Rec.709 — это примары рендера, и весь грейд
// выше живёт в них. Но экран не обязан быть Rec.709: у macOS с Display P3 или
// у HDR-дисплея с Rec.2020 те же три числа означают ДРУГИЕ цвета, потому что
// красный «единица» у P3 заметно дальше от белого. Без пересчёта картинка на
// широком дисплее выходит перенасыщенной ровно на разницу примар, и это не
// вопрос вкуса: тот же самый кадр буквально показывается не теми цветами.
//
// Рабочее пространство грейда НЕ меняется. Перевести весь грейд в AP1 или
// Rec.2020 было бы «правильнее по учебнику», но числа в PostProcessLook.Grade
// подобраны глазами в Rec.709, и смена рабочих примар молча переопределила бы
// каждое из них. Пересчёт стоит последним, на display-referred величинах, и
// меняет только адресацию цвета, а не сам вид.
//
// Суммы строк равны единице у обеих матриц, и это не совпадение: Rec.709,
// Display P3 и Rec.2020 стоят на одной белой точке D65, поэтому белое обязано
// переходить в белое покомпонентно. Проверяется линтером — расхождение здесь
// означало бы уехавшую белую точку, а её на глаз не видно, пока не поставишь
// рядом эталон.

#define FODINAE_GAMUT_REC709 0
#define FODINAE_GAMUT_DISPLAY_P3 1
#define FODINAE_GAMUT_REC2020 2

float3 ConvertOutputGamut(float3 color, int outputGamut)
{
    const float3x3 rec709ToDisplayP3 = float3x3(
        0.822462, 0.177538, 0.000000,
        0.033194, 0.966806, 0.000000,
        0.017083, 0.072397, 0.910520);
    const float3x3 rec709ToRec2020 = float3x3(
        0.627404, 0.329283, 0.043313,
        0.069097, 0.919540, 0.011362,
        0.016391, 0.088013, 0.895595);

    float3 result = color;
    if (outputGamut == FODINAE_GAMUT_DISPLAY_P3)
    {
        result = mul(rec709ToDisplayP3, color);
    }
    else if (outputGamut == FODINAE_GAMUT_REC2020)
    {
        result = mul(rec709ToRec2020, color);
    }

    return result;
}

#endif // FODINAE_COLOR_GRADING_INCLUDED
