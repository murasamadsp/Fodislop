/* ═══════════════════════════════════════════════════════════
   PauseMenu — стили меню паузы
   ═══════════════════════════════════════════════════════════ */

.pause-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 1000;
    justify-content: center;
    align-items: center;
}

.pause-dimmer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
}

.pause-panel {
    background-color: var(--color-panel-bg);
    border-width: 2px;
    border-color: var(--color-panel-border);
    padding: 20px 30px;
    flex-direction: column;
    align-items: center;
    width: 520px;
    max-width: 80%;
    height: 85%;
    min-height: 0;
    flex-shrink: 0;
    overflow: hidden;
    min-width: 260px;
    align-self: center;
}

.pause-settings {
    width: 760px;
    max-width: 90%;
}

.pause-page {
    align-items: center;
}

.pause-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--color-accent);
    margin-bottom: 16px;
}

.pause-slider-container {
    flex-direction: column;
    margin-bottom: 12px;
    min-width: 240px;
}

.pause-slider-label {
    font-size: var(--font-size-md);
    color: var(--color-text);
    margin-bottom: 4px;
}

.pause-scroll {
    width: 100%;
    flex-grow: 1;
    min-height: 0;
    flex-shrink: 1;
}

.settings-layout {
    flex-direction: row;
    width: 100%;
    height: 0;
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.settings-navigation {
    width: 150px;
    min-width: 150px;
    flex-shrink: 0;
    padding-right: 12px;
    border-right-width: 1px;
    border-right-color: rgba(90, 90, 90, 0.65);
}

.settings-content {
    position: relative;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    height: 0;
    min-width: 0;
    min-height: 0;
    padding-left: 14px;
    overflow: hidden;
}

.settings-page {
    position: relative;
    width: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
}

.settings-tab {
    min-width: 0;
    width: 100%;
    margin-bottom: 6px;
    padding: 8px 10px;
    -unity-text-align: middle-left;
}

.settings-tab--active {
    background-color: var(--color-accent);
    color: rgba(20, 20, 20, 1);
}

.settings-tab--debug {
    margin-top: auto;
    border-color: rgba(190, 120, 70, 0.75);
}

.settings-section {
    flex-direction: column;
    width: 100%;
    min-width: 0;
    margin-bottom: 18px;
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(90, 90, 90, 0.65);
}

.settings-section__title {
    color: var(--color-accent);
    font-size: var(--font-size-lg);
    -unity-font-style: bold;
    margin-bottom: 10px;
}

.settings-section--advanced,
.settings-section--debug {
    background-color: rgba(0, 0, 0, 0.18);
    border-width: 1px;
    border-color: rgba(90, 90, 90, 0.65);
    padding: 10px;
}

.settings-section--advanced .unity-foldout__content,
.settings-section--debug .unity-foldout__content {
    margin-top: 10px;
    padding-left: 8px;
}

.settings-section--debug {
    border-color: rgba(190, 120, 70, 0.75);
}

.pause-confirm-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    align-items: center;
    justify-content: center;
}

.pause-confirm-panel {
    background-color: var(--color-panel-bg);
    border-width: 2px;
    border-color: var(--color-panel-border);
    padding: 20px 40px;
    flex-direction: column;
    align-items: center;
    min-width: 300px;
}

.pause-confirm-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--color-accent);
    margin-bottom: 12px;
}

.pause-confirm-desc {
    font-size: var(--font-size-md);
    color: var(--color-text);
    white-space: normal;
    margin-bottom: 20px;
    -unity-text-align: middle-center;
}

.pause-confirm-buttons {
    flex-direction: row;
    justify-content: center;
}

.pause-btn-confirm {
    background-color: rgba(128, 38, 38, 1);
    border-width: 2px;
    border-color: rgba(153, 51, 51, 1);
    padding: 8px 20px;
    min-width: 100px;
    color: var(--color-text);
    font-size: var(--font-size-md);
    -unity-text-align: middle-center;
    margin-right: 10px;
}

.pause-btn {
    background-color: var(--btn-bg);
    border-width: 2px;
    border-color: var(--btn-border);
    padding: 8px 20px;
    min-width: 180px;
    margin-bottom: 10px;
    color: var(--color-text);
    font-size: var(--font-size-md);
    -unity-text-align: middle-center;
}

.pause-btn:hover {
    background-color: var(--btn-hover);
}

.pause-debug-divider {
    font-size: 12px;
    color: rgb(128, 128, 128);
    margin-top: 10px;
    margin-bottom: 6px;
    -unity-text-align: middle-center;
}
