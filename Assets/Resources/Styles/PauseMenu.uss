/* ═══════════════════════════════════════════════════════════
   PauseMenu — стили меню паузы
   ═══════════════════════════════════════════════════════════ */

.pause-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

.pause-dimmer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
}

.pause-panel {
    background-color: rgba(16, 18, 22, 0.97);
    border-width: 2px;
    border-color: var(--border-subtle);
    padding: 24px 30px;
    flex-direction: column;
    align-items: center;
    width: 520px;
    max-width: 80%;
    height: 85%;
    min-height: 0;
    flex-shrink: 0;
    overflow: hidden;
    min-width: 260px;
    align-self: center;
}

.pause-settings {
    width: 760px;
    max-width: 90%;
    padding-left: 28px;
    padding-right: 28px;
}

.pause-page {
    align-items: center;
}

.pause-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--accent-gold);
    margin-bottom: 16px;
    flex-shrink: 0;
}

.pause-slider-container {
    flex-direction: column;
    margin-bottom: 18px;
    padding-top: 4px;
    min-width: 240px;
}

.pause-slider-label {
    font-size: var(--size-md);
    color: var(--text-primary);
    margin-bottom: 8px;
    white-space: normal;
}

.pause-scroll {
    width: 100%;
    flex-grow: 1;
    min-height: 0;
    flex-shrink: 1;
}

.settings-layout {
    flex-direction: row;
    width: 100%;
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 1;
    margin-bottom: 18px;
}

.settings-navigation {
    width: 150px;
    min-width: 150px;
    flex-shrink: 0;
    padding-top: 6px;
    padding-right: 18px;
    margin-right: 2px;
    border-right-width: 1px;
    border-right-color: rgba(90, 90, 90, 0.65);
}

.settings-content {
    position: relative;
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    padding-left: 20px;
    padding-right: 8px;
    overflow: hidden;
}

.settings-page {
    position: relative;
    width: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.settings-page .unity-scroll-view__content-viewport {
    padding-top: 6px;
    padding-right: 14px;
    padding-bottom: 28px;
    padding-left: 2px;
}

.settings-page .unity-scroll-view__content-container {
    padding-bottom: 18px;
}

.settings-tab {
    min-width: 0;
    width: 100%;
    margin-bottom: 10px;
    padding: 10px 12px;
    -unity-text-align: middle-left;
}

.settings-tab--active {
    background-color: var(--accent-gold);
    color: rgba(20, 20, 20, 1);
}

.settings-tab--advanced {
    margin-top: auto;
    border-color: rgba(190, 120, 70, 0.75);
}

.settings-section {
    flex-direction: column;
    width: 100%;
    min-width: 0;
    margin-bottom: 22px;
    padding: 14px 14px 16px 14px;
    background-color: rgba(30, 34, 41, 0.92);
    border-width: 1px;
    border-color: rgba(105, 112, 125, 0.65);
    border-radius: 3px;
}

.settings-section__title {
    color: var(--accent-gold);
    font-size: var(--size-lg);
    -unity-font-style: bold;
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(178, 166, 128, 0.55);
}

.settings-section__description {
    color: rgba(190, 196, 205, 1);
    font-size: var(--size-sm);
    white-space: normal;
    margin-bottom: 16px;
    padding-bottom: 2px;
}

.pause-subsection {
    flex-direction: column;
}

.pause-subsection-title {
    color: var(--accent-gold);
    font-size: var(--size-md);
    -unity-font-style: bold;
    margin: 12px 0 6px 0;
}

.settings-section .unity-label,
.settings-section .unity-base-field__label,
.settings-section .unity-toggle__label,
.settings-section .unity-foldout__text {
    color: rgba(245, 246, 248, 1);
}

.settings-section--advanced,
.settings-section--debug {
    background-color: rgba(24, 27, 33, 0.98);
    border-width: 1px;
    border-color: rgba(90, 90, 90, 0.65);
    padding: 14px;
}

.settings-section--custom {
    background-color: rgba(35, 31, 24, 0.98);
    border-color: rgba(205, 170, 90, 0.8);
}

.settings-section--effects {
    background-color: rgba(29, 34, 44, 0.96);
    border-color: rgba(105, 145, 190, 0.75);
}

.settings-section--custom .unity-foldout__content {
    margin-top: 12px;
    padding-left: 8px;
    padding-right: 4px;
}

.settings-section--advanced .unity-foldout__content,
.settings-section--debug .unity-foldout__content {
    margin-top: 14px;
    padding-left: 10px;
    padding-right: 4px;
}

.settings-section--debug {
    border-color: rgba(190, 120, 70, 0.75);
}

.pause-confirm-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    align-items: center;
    justify-content: center;
}

.pause-confirm-panel {
    background-color: var(--surface-panel);
    border-width: 2px;
    border-color: var(--border-subtle);
    padding: 20px 40px;
    flex-direction: column;
    align-items: center;
    min-width: 300px;
}

.pause-confirm-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--accent-gold);
    margin-bottom: 12px;
}

.pause-confirm-desc {
    font-size: var(--size-md);
    color: var(--text-primary);
    white-space: normal;
    margin-bottom: 20px;
    -unity-text-align: middle-center;
}

.pause-confirm-buttons {
    flex-direction: row;
    justify-content: center;
}

.pause-btn-confirm {
    background-color: rgba(128, 38, 38, 1);
    border-width: 2px;
    border-color: rgba(153, 51, 51, 1);
    padding: 8px 20px;
    min-width: 100px;
    color: var(--text-primary);
    font-size: var(--size-md);
    -unity-text-align: middle-center;
    margin-right: 10px;
}

.pause-btn {
    background-color: var(--surface-raised);
    border-width: 2px;
    border-color: var(--border-subtle);
    padding: 8px 20px;
    min-width: 180px;
    margin-bottom: 10px;
    color: var(--text-primary);
    font-size: var(--size-md);
    -unity-text-align: middle-center;
}

#SettingsBack {
    flex-shrink: 0;
    margin-top: 4px;
    margin-bottom: 0;
}

.pause-btn:hover {
    background-color: var(--accent-cyan-wash);
}
