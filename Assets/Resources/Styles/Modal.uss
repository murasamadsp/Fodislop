/* ═══════════════════════════════════════════════════════════
   Modal — стили модальных окон
   ═══════════════════════════════════════════════════════════ */

.modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    align-items: center;
    justify-content: center;
}

.modal-window {
    background-color: var(--color-panel-bg);
    border-color: var(--color-panel-border);
    border-width: var(--panel-border-width);
    border-radius: 6px;
    padding: 16px;
    min-width: 300px;
    max-width: 500px;
}

.modal-title {
    font-size: var(--font-size-lg);
    color: var(--color-accent);
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}

.modal-body {
    color: var(--color-text);
    font-size: var(--font-size-md);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.modal-buttons {
    flex-direction: row;
    justify-content: center;
}

/* In-game popup dialogs (respawn, buildings, FAQ) */
.popup-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    display: none;
}

.popup-dimmer {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.4);
}

.popup-panel {
    background-color: rgba(20, 20, 20, 0.95);
    border-color: var(--color-panel-border);
    border-width: 2px;
    padding: 20px 40px;
    flex-direction: column;
    align-items: center;
    min-width: 200px;
}

.popup-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--color-accent);
    margin-bottom: 20px;
    -unity-text-align: middle-center;
}

.popup-close-btn {
    background-color: rgba(38, 38, 38, 1);
    border-color: var(--color-panel-border);
    border-width: 2px;
    padding: 8px 20px;
    color: white;
    font-size: 14px;
    -unity-text-align: middle-center;
}

.popup-btn-row {
    flex-direction: row;
    justify-content: center;
}

.popup-btn {
    background-color: rgba(38, 38, 38, 1);
    border-color: rgba(90, 90, 90, 1);
    border-width: 2px;
    padding: 8px 20px;
    margin: 0 8px;
    min-width: 100px;
    color: white;
    font-size: 14px;
    -unity-text-align: middle-center;
}

.popup-btn:hover {
    background-color: rgba(90, 90, 90, 1);
}

/* ─── Модальное окно серверного пакета (ModalWindowHandler) ─── */

.modal-icon {
    width: 64px;
    height: 64px;
    margin-bottom: 10px;
    background-color: rgb(51, 51, 51);
}

.modal-desc {
    font-size: 14px;
    color: white;
    white-space: normal;
    margin-bottom: 20px;
    -unity-text-align: middle-center;
}

/* ─── Тултип ─── */

.tooltip-panel {
    position: absolute;
    background-color: rgba(26, 26, 26, 0.95);
    border-width: 1px;
    border-color: rgb(102, 102, 102);
    padding: 6px 10px;
    max-width: 250px;
}

.tooltip-label {
    font-size: 12px;
    color: white;
    white-space: normal;
}

/* ─── Ошибка приложения ─── */

.game-error-overlay {
    padding: 32px;
}

.error-title {
    margin-bottom: 16px;
    color: var(--color-danger);
    font-size: var(--font-size-xl);
    -unity-text-align: middle-center;
}

.error-message {
    max-width: 900px;
    margin-bottom: 24px;
    padding-left: 40px;
    padding-right: 40px;
    color: var(--color-text);
    font-size: var(--font-size-md);
    white-space: normal;
    -unity-text-align: middle-center;
}

.error-close-button {
    width: 120px;
    height: 32px;
    border-radius: 4px;
}
