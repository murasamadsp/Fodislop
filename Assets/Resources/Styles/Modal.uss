/* ═══════════════════════════════════════════════════════════
   Modal — стили модальных окон
   ═══════════════════════════════════════════════════════════ */

.modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    align-items: center;
    justify-content: center;
}

.modal-window {
    background-color: var(--color-panel-bg);
    border-color: var(--color-panel-border);
    border-width: var(--panel-border-width);
    border-radius: 6px;
    padding: 16px;
    min-width: 300px;
    max-width: 500px;
}

.modal-title {
    font-size: var(--font-size-lg);
    color: var(--color-accent);
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}

.modal-body {
    color: var(--color-text);
    font-size: var(--font-size-md);
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.modal-buttons {
    flex-direction: row;
    justify-content: center;
}

/* In-game popup dialogs (respawn, buildings, FAQ) */
/* ─── Попап ───
   Единственное определение. Раньше блок существовал дважды — здесь и в
   HUD.uss; поскольку HUD импортируется позже, эта версия молча
   перекрывалась почти целиком, но не полностью: свойства, которых у HUD
   не было (центрирование панели, выключка заголовка, паддинг кнопки
   закрытия), продолжали приходить отсюда. Версии слиты, значения
   переведены на токены. */

.popup-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    display: none;
}

.popup-dimmer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    /* backdrop-filter в USS нет — размытие фона заменяется плотной заливкой. */
    background-color: var(--surface-scrim);
}

.popup-panel {
    background-color: var(--surface-panel);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: var(--radius-md);
    padding: var(--space-8);
    min-width: 260px;
    flex-direction: column;
    align-items: center;
}

.popup-title {
    font-size: var(--size-lg);
    -unity-font-style: bold;
    color: var(--accent-gold);
    margin-bottom: var(--space-4);
    -unity-text-align: middle-center;
}

.popup-close-btn {
    margin-top: var(--space-4);
    align-self: flex-end;
    background-color: transparent;
    color: var(--text-secondary);
    font-size: var(--size-sm);
    border-width: 0;
    padding: var(--space-2) var(--space-5);
}

.popup-btn-row {
    flex-direction: row;
    justify-content: center;
    margin-top: var(--space-6);
}

.popup-btn {
    background-color: var(--btn-bg);
    border-color: var(--btn-border);
    border-width: 1px;
    border-radius: var(--radius-sm);
    padding: var(--space-4) var(--space-9);
    min-width: 96px;
    margin: 0 var(--space-2);
    color: var(--text-primary);
    font-size: var(--size-base);
    -unity-text-align: middle-center;
}

.popup-btn:hover {
    background-color: var(--btn-hover);
    border-color: var(--border-cyan);
}

/* ─── Модальное окно серверного пакета (ModalWindowHandler) ─── */

.modal-icon {
    width: 64px;
    height: 64px;
    margin-bottom: 10px;
    background-color: rgb(51, 51, 51);
}

.modal-desc {
    font-size: 14px;
    color: white;
    white-space: normal;
    margin-bottom: 20px;
    -unity-text-align: middle-center;
}

/* ─── Тултип ─── */

.tooltip-panel {
    position: absolute;
    background-color: rgba(26, 26, 26, 0.95);
    border-width: 1px;
    border-color: rgb(102, 102, 102);
    padding: 6px 10px;
    max-width: 250px;
}

.tooltip-label {
    font-size: 12px;
    color: white;
    white-space: normal;
}

/* ─── Ошибка приложения ─── */

.game-error-overlay {
    padding: 32px;
}

.error-title {
    margin-bottom: 16px;
    color: var(--color-danger);
    font-size: var(--font-size-xl);
    -unity-text-align: middle-center;
}

.error-message {
    max-width: 900px;
    margin-bottom: 24px;
    padding-left: 40px;
    padding-right: 40px;
    color: var(--color-text);
    font-size: var(--font-size-md);
    white-space: normal;
    -unity-text-align: middle-center;
}

.error-close-button {
    width: 120px;
    height: 32px;
    border-radius: 4px;
}

/* ═══════════════════════════════════════════════════════════
   Индикатор загрузки ассетов (AssetLoadingIndicator.uxml)

   У классов .loadind-* не было стилей ни в одном файле проекта: разметка
   существовала, но выводилась дефолтным оформлением UI Toolkit — белый
   текст в левом верхнем углу без фона. Приведено к языку системы.
   ═══════════════════════════════════════════════════════════ */

.loadind-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.loadind-overlay {
    position: absolute;
    right: var(--space-9);
    bottom: var(--space-9);
    min-width: 260px;
    padding: var(--space-6) var(--space-8);
    background-color: var(--surface-panel);
    border-width: 1px;
    border-color: var(--border-cyan);
    border-radius: var(--radius-sm);
    flex-direction: column;
}

.loadind-title {
    -unity-font-definition: var(--face-data);
    font-size: var(--size-xs);
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--accent-cyan);
    margin-bottom: var(--space-3);
}

/* Крутится через C#: @keyframes в USS нет. */
.loadind-spinner {
    position: absolute;
    right: var(--space-8);
    top: var(--space-6);
    font-size: var(--size-md);
    color: var(--accent-cyan);
}

.loadind-status {
    -unity-font-definition: var(--face-body);
    font-size: var(--size-sm);
    color: var(--text-secondary);
    white-space: normal;
    margin-bottom: var(--space-2);
}

.loadind-progress {
    -unity-font-definition: var(--face-data);
    font-size: var(--size-2xs);
    color: var(--text-tertiary);
}
