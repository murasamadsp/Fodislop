/* ═══════════════════════════════════════════════════════════
   Chat — стили чата
   ═══════════════════════════════════════════════════════════ */

.chat-container {
    background-color: var(--surface-panel);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: 4px;
    padding: var(--space-6);
    width: 400px;
    max-height: 300px;
}

.chat-scroll {
    flex-grow: 1;
    margin-bottom: 6px;
}

.chat-message {
    font-size: var(--size-sm);
    color: var(--text-primary);
    padding: 2px;
    white-space: normal;
    overflow: hidden;
}

.chat-input {
    background-color: rgba(30, 30, 30, 1);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: 3px;
    padding: 4px 8px;
    color: var(--text-primary);
    font-size: var(--size-sm);
}

/* ─── Глобальный чат (GlobalChatUI) ─── */

.gchat-panel {
    position: absolute;
    right: 10px;
    top: 50%;
    translate: 0 -50%;
    width: 340px;
    height: 420px;
    background-color: rgba(20, 20, 20, 0.9);
    border-width: 2px;
    border-color: rgb(89, 89, 89);
    padding: 8px;
    flex-direction: column;
}

.gchat-header {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(178, 166, 128);
    margin-bottom: 4px;
}

.gchat-channel-tabs {
    flex-direction: row;
    margin-bottom: 6px;
}

.gchat-channel-button {
    flex-grow: 1;
    height: 26px;
    padding: 0 8px;
    background-color: rgba(30, 30, 30, 0.85);
    border-width: 1px;
    border-color: rgb(77, 77, 77);
    color: rgb(170, 170, 170);
    -unity-text-align: middle-center;
}

.gchat-channel-button--active {
    background-color: rgba(89, 74, 42, 0.9);
    border-color: rgb(178, 166, 128);
    color: rgb(255, 239, 190);
}

.gchat-mute-status {
    color: rgb(255, 190, 100);
    margin-bottom: 6px;
    white-space: normal;
}

.gchat-scroll {
    flex-grow: 1;
    margin-bottom: 6px;
    background-color: rgba(0, 0, 0, 0.3);
    border-width: 1px;
    border-color: rgb(51, 51, 51);
}

.gchat-message {
    font-size: 12px;
    color: white;
    margin-bottom: 2px;
    padding-left: 2px;
    padding-right: 2px;
    white-space: normal;
    overflow: hidden;
    -unity-font-style: normal;
}

.gchat-bottom-row {
    flex-direction: row;
    height: 28px;
    flex-shrink: 0;
    flex-grow: 0;
}

.gchat-input {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: 12px;
    color: white;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgb(77, 77, 77);
    padding: 2px 4px;
}

.gchat-send-button {
    width: 32px;
    flex-shrink: 0;
    padding: 0;
    background-color: rgb(51, 51, 51);
    color: white;
    font-size: 14px;
    -unity-text-align: middle-center;
    border-width: 1px;
    border-left-width: 0;
    border-color: rgb(77, 77, 77);
}

.gchat-color-button {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    padding: 0;
    border-width: 1px;
    border-left-width: 0;
    border-color: rgb(77, 77, 77);
}

.gchat-color-grid {
    flex-direction: row;
    flex-wrap: wrap;
    width: 170px;
    flex-shrink: 0;
    justify-content: center;
    background-color: rgba(31, 31, 31, 0.95);
    border-width: 1px;
    border-color: rgb(77, 77, 77);
    padding: 4px;
}

.gchat-swatch {
    width: 20px;
    height: 20px;
    margin: 1px;
    padding: 0;
    border-width: 1px;
    border-color: rgb(102, 102, 102);
}

.gchat-internal-input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
    margin: 0;
    font-size: 14px;
    color: white;
}

/* ─── Локальный чат (LocalChatPopup) ─── */

.lchat-overlay {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 400px;
    height: 36px;
    background-color: rgba(15, 15, 15, 0.92);
    border-width: 2px;
    border-color: rgb(89, 89, 89);
    padding: 2px 4px;
    flex-direction: row;
    align-items: center;
}

.lchat-prompt {
    font-size: 14px;
    color: rgb(178, 166, 128);
    margin-right: 4px;
    -unity-font-style: bold;
}

.lchat-input {
    flex-grow: 1;
    font-size: 14px;
    color: white;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
    -unity-font-style: normal;
}

.lchat-internal-input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
    color: white;
}
