/* ═══════════════════════════════════════════════════════════
   Inventory & Hotbar — системные стили инвентаря Fodinae
   ═══════════════════════════════════════════════════════════ */

/* ─── Полный инвентарь (Overlay & Центрирование) ─── */

.inv-full-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.6);
    picking-mode: position;
}

.inv-full-bg {
    background-color: rgba(14, 18, 26, 0.95);
    border-width: 1px;
    border-color: rgba(80, 140, 200, 0.5);
    border-radius: 6px;
    padding: 20px;
    flex-direction: column;
    align-items: center;
    min-width: 560px;
}

.inv-close-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 28px;
    height: 28px;
    background-color: rgba(0, 0, 0, 0.3);
    border-width: 1px;
    border-color: rgba(80, 140, 200, 0.3);
    border-radius: 4px;
    padding: 0;
    justify-content: center;
    align-items: center;
}

.inv-close-btn:hover {
    background-color: rgba(180, 40, 40, 0.8);
    border-color: rgba(255, 80, 80, 0.8);
}

.inv-close-label {
    font-size: 16px;
    color: rgb(200, 200, 200);
    -unity-text-align: middle-center;
    align-self: center;
    justify-content: center;
}

.inv-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(220, 235, 255);
    margin-bottom: 12px;
    align-self: flex-start;
}

.inv-separator {
    height: 1px;
    background-color: rgba(80, 140, 200, 0.3);
    margin-top: 12px;
    margin-bottom: 12px;
    align-self: center;
}

/* ─── Сетка и ячейки ─── */

.inv-grid {
    flex-direction: column;
    align-items: center;
}

.inv-grid-row {
    flex-direction: row;
}

.inv-cell {
    width: 50px;
    height: 50px;
    justify-content: center;
    align-items: center;
    margin: 3px;
    background-color: rgba(20, 26, 38, 0.85);
    border-width: 1px;
    border-color: rgba(80, 140, 200, 0.4);
    border-radius: 4px;
    picking-mode: position;
}

.inv-cell:hover {
    border-color: rgba(80, 180, 255, 0.9);
    background-color: rgba(30, 42, 62, 0.9);
}

.inv-cell--selected {
    border-width: 2px;
    border-color: rgb(255, 214, 0);
    background-color: rgba(60, 50, 20, 0.4);
}

.inv-cell--highlight {
    background-color: rgba(50, 70, 100, 0.8);
}

.inv-icon {
    width: 36px;
    height: 36px;
    align-self: center;
    justify-content: center;
}

.inv-qty {
    position: absolute;
    right: 3px;
    bottom: 2px;
    font-size: 11px;
    color: white;
    -unity-font-style: bold;
}

.inv-floating {
    position: absolute;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    opacity: 0.8;
}

/* ─── Хотбар ─── */

.inv-hotbar {
    position: absolute;
    bottom: 16px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    picking-mode: ignore;
}

.inv-button {
    width: 50px;
    height: 50px;
    margin: 3px;
    background-color: rgba(30, 50, 75, 0.85);
    border-width: 1px;
    border-color: rgba(80, 180, 255, 0.5);
    border-radius: 4px;
    padding: 0;
    picking-mode: position;
    justify-content: center;
    align-items: center;
}

.inv-button:hover {
    background-color: rgba(50, 85, 130, 0.95);
    border-color: rgba(100, 210, 255, 0.9);
}

/* ─── Тултип выбранного предмета ─── */

.inv-tooltip-wrapper {
    position: absolute;
    left: 0;
    right: 0;
    top: 48px;
    height: 36px;
    flex-direction: row;
    justify-content: center;
    picking-mode: ignore;
}

.inv-tooltip-bg {
    flex-direction: row;
    align-items: center;
    background-color: rgba(14, 18, 26, 0.95);
    border-width: 1px;
    border-color: rgba(80, 140, 200, 0.5);
    border-radius: 4px;
    padding: 6px 12px;
}

.inv-tooltip-name {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(255, 214, 0);
    margin-right: 10px;
}

.inv-tooltip-desc {
    font-size: 12px;
    color: rgb(210, 225, 240);
}

/* ─── Контекстное меню ─── */

.inv-context-menu {
    position: absolute;
    background-color: rgba(14, 18, 26, 0.95);
    border-width: 1px;
    border-color: rgba(80, 140, 200, 0.5);
    border-radius: 4px;
    padding: 4px 0;
    flex-direction: column;
    min-width: 150px;
}

.inv-context-btn {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 6px 12px;
    color: rgb(220, 235, 255);
    font-size: 13px;
    -unity-text-align: middle-left;
    min-height: 28px;
}

.inv-context-btn:hover {
    background-color: rgba(50, 85, 130, 0.8);
}
