/* ═══════════════════════════════════════════════════════════
   Programmator — стили программатора
   ═══════════════════════════════════════════════════════════ */

.programmator-root {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    background-color: var(--color-panel-bg);
    border-color: var(--color-panel-border);
    border-width: var(--panel-border-width);
    border-radius: 4px;
    padding: var(--panel-padding);
}

.programmator-grid {
    flex-wrap: wrap;
    background-color: rgba(30, 30, 30, 1);
    border-color: var(--btn-border);
    border-width: 1px;
    border-radius: 3px;
    padding: 4px;
}

.programmator-cell {
    width: 40px;
    height: 40px;
    background-color: rgba(38, 38, 38, 1);
    border-color: var(--btn-border);
    border-width: 1px;
    border-radius: 2px;
    margin: 1px;
    -unity-text-align: middle-center;
    font-size: var(--font-size-sm);
    color: var(--color-text);
}

.programmator-cell:hover {
    border-color: var(--color-accent);
}

.programmator-cell.has-operator {
    background-color: rgba(178, 166, 128, 0.3);
    color: var(--color-accent);
}

.programmator-toolbar {
    flex-direction: row;
    margin-top: 8px;
}

/* ─── Радиальное меню ─── */

.prog-radial-root {
    position: absolute;
    width: 260px;
    height: 260px;
}

.prog-radial-fill {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.prog-radial-item {
    position: absolute;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background-color: rgba(51, 51, 51, 0.95);
    border-width: 2px;
    border-color: rgb(128, 128, 128);
}

.prog-radial-item-label {
    color: white;
    font-size: 8px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.prog-radial-back {
    position: absolute;
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background-color: rgba(38, 38, 38, 0.95);
    border-width: 2px;
    border-color: rgb(128, 128, 128);
}

.prog-radial-back:hover {
    border-color: rgb(255, 214, 0);
}

.prog-radial-back-label {
    color: white;
    font-size: 18px;
    -unity-text-align: middle-center;
}

/* ─── Окно программатора и панели ─── */

.prog-popup {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

.prog-dimmer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.4);
}

.prog-panel {
    background-color: rgba(20, 20, 20, 0.95);
    border-width: 2px;
    border-color: rgb(89, 89, 89);
    padding: 10px;
    flex-direction: column;
    width: 618px;
    min-height: 520px;
}

.prog-panel--running {
    border-color: rgb(51, 204, 51);
}

.prog-top {
    flex-direction: column;
    margin-bottom: 10px;
}

.prog-header-row {
    flex-direction: row;
    align-items: flex-start;
}

.prog-row {
    flex-direction: row;
    align-items: center;
}

.prog-action-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.prog-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(178, 166, 128);
}

.prog-grid-row {
    flex-direction: row;
    justify-content: center;
}

/* ─── Кнопки управления ─── */

.prog-ctrl-btn {
    width: 22px;
    height: 22px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(178, 178, 178);
    font-size: 14px;
    -unity-text-align: middle-center;
    border-width: 0;
    padding: 0 2px;
}

.prog-close-btn {
    width: 24px;
    height: 24px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(178, 178, 178);
    font-size: 18px;
    -unity-text-align: middle-center;
    border-width: 0;
    padding: 0;
}

.prog-close-btn:hover {
    color: white;
}

.prog-save-btn {
    width: 24px;
    height: 24px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(178, 178, 178);
    font-size: 14px;
    -unity-text-align: middle-center;
    border-width: 0;
    padding: 0;
}

.prog-run-btn {
    width: 22px;
    height: 22px;
    background-color: rgba(0, 89, 0, 0.3);
    color: rgb(102, 229, 102);
    font-size: 12px;
    -unity-text-align: middle-center;
    border-width: 0;
    padding: 0;
    margin-left: 4px;
}

.prog-stop-btn {
    width: 22px;
    height: 22px;
    background-color: rgba(89, 0, 0, 0.3);
    color: rgb(229, 77, 77);
    font-size: 12px;
    -unity-text-align: middle-center;
    border-width: 0;
    padding: 0;
}

.prog-del-btn {
    width: 22px;
    height: 22px;
    background-color: rgba(77, 0, 0, 0.3);
    color: rgb(229, 77, 77);
    font-size: 14px;
    -unity-text-align: middle-center;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    padding: 0;
    margin-left: 8px;
}

/* ─── Пейджер ─── */

.prog-pager-label {
    font-size: 12px;
    color: rgb(178, 166, 128);
    min-width: 60px;
    -unity-text-align: middle-center;
    margin-left: 4px;
    margin-right: 4px;
}

.prog-page-input {
    width: 52px;
    height: 22px;
    background-color: rgb(31, 31, 31);
    color: rgb(178, 166, 128);
    font-size: 12px;
    -unity-text-align: middle-center;
    border-width: 0;
    margin: 0 4px;
    padding: 0;
}

.prog-page-input .unity-text-input {
    background-color: rgb(31, 31, 31);
    color: rgb(178, 166, 128);
    font-size: 12px;
    -unity-text-align: middle-center;
    border-width: 0;
    padding: 0;
    margin: 0;
}

/* ─── Сетка ─── */

.prog-grid-container {
    flex-direction: row;
    flex-wrap: wrap;
}

.prog-cell {
    width: 32px;
    height: 32px;
    background-color: rgb(38, 38, 38);
    border-width: 1px;
    border-color: rgb(64, 64, 64);
    margin: 2px;
}

.prog-cell--hover {
    border-color: rgb(255, 214, 0);
}

.prog-cell--selected {
    border-color: rgb(51, 128, 255);
}

.prog-cell-label {
    font-size: 8px;
    color: white;
    -unity-text-align: middle-center;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 0;
}

/* ─── Список программ ─── */

.prog-list-panel {
    background-color: rgba(20, 20, 20, 0.95);
    border-width: 2px;
    border-color: rgb(89, 89, 89);
    padding: 10px 20px;
    flex-direction: column;
    width: 400px;
    min-height: 300px;
}

.prog-list-header-row {
    flex-direction: row;
    margin-bottom: 10px;
}

.prog-list-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(178, 166, 128);
    flex-grow: 1;
}

.prog-list-scroll {
    flex-grow: 1;
    min-height: 200px;
}

.prog-list-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(51, 51, 51);
}

.prog-list-row:hover {
    background-color: rgb(38, 38, 38);
}

.prog-list-name {
    flex-grow: 1;
    color: rgb(204, 204, 204);
    font-size: 14px;
    -unity-text-align: middle-left;
}

.prog-create-container {
    flex-direction: column;
    margin-top: 10px;
}

.prog-create-btn {
    width: 100%;
    height: 30px;
    background-color: rgb(38, 38, 38);
    color: rgb(178, 166, 128);
    font-size: 14px;
    -unity-text-align: middle-center;
    border-width: 1px;
    border-color: rgb(89, 89, 89);
}

.prog-create-btn:hover {
    background-color: rgb(51, 51, 51);
}

/* ─── Диалог создания программы ─── */

.prog-dialog {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

.prog-dialog-panel {
    background-color: rgba(20, 20, 20, 0.95);
    border-width: 2px;
    border-color: rgb(89, 89, 89);
    padding: 16px 20px;
    flex-direction: column;
    align-items: stretch;
    width: 350px;
}

.prog-dialog-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(178, 166, 128);
    margin-bottom: 12px;
}

.prog-dialog-input {
    height: 32px;
    background-color: rgb(31, 31, 31);
    color: rgb(204, 204, 204);
    font-size: 14px;
    border-width: 1px;
    border-color: rgb(77, 77, 77);
    padding-left: 8px;
    margin-bottom: 16px;
}

.prog-dialog-input .unity-text-input {
    background-color: rgb(31, 31, 31);
    color: rgb(204, 204, 204);
    font-size: 14px;
    border-width: 0;
}

.prog-dialog-buttons {
    flex-direction: row;
    justify-content: flex-end;
}

.prog-dialog-cancel {
    height: 30px;
    min-width: 80px;
    background-color: rgb(38, 38, 38);
    color: rgb(178, 178, 178);
    font-size: 14px;
    -unity-text-align: middle-center;
    border-width: 1px;
    border-color: rgb(77, 77, 77);
    margin-right: 8px;
}

.prog-dialog-confirm {
    height: 30px;
    min-width: 80px;
    background-color: rgba(0, 77, 0, 0.3);
    color: rgb(102, 229, 102);
    font-size: 14px;
    -unity-text-align: middle-center;
    border-width: 1px;
    border-color: rgb(51, 128, 51);
}

/* ─── Джойстик Observer ─── */

.prog-joy-root {
    position: absolute;
    width: 200px;
    height: 200px;
}

.prog-joy-center {
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
}
