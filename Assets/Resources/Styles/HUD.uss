/* ═══════════════════════════════════════════════════════════
   HUD — стили интерфейса игрока
   ═══════════════════════════════════════════════════════════ */

.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.world-map-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.82);
}

.world-map-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.hud-top-left {
    position: absolute;
    top: 10px;
    left: 10px;
}

.hud-top-right {
    position: absolute;
    top: 10px;
    right: 10px;
}

.hud-bottom-left {
    position: absolute;
    bottom: 10px;
    left: 10px;
}

.hud-bottom-right {
    position: absolute;
    bottom: 10px;
    right: 10px;
}

.asset-status-root {
    position: absolute;
    right: 10px;
    bottom: 10px;
    align-items: flex-end;
}

.asset-status-button {
    min-width: 38px;
    width: auto;
    height: 28px;
    padding: 0 8px;
    background-color: rgba(25, 25, 25, 0.92);
    border-color: rgba(130, 130, 130, 0.9);
    border-width: 1px;
    border-radius: 14px;
    color: white;
    -unity-text-align: middle-center;
}

.asset-status-button:hover,
.asset-status-button.asset-status-loading {
    background-color: rgba(70, 70, 70, 0.96);
    border-color: var(--color-accent);
}

.asset-status-button-label {
    color: white;
    font-size: 12px;
    -unity-text-align: middle-center;
}

.asset-status-panel {
    width: 300px;
    margin-bottom: 6px;
    padding: 8px;
    background-color: rgba(20, 20, 20, 0.96);
    border-color: rgba(120, 120, 120, 0.9);
    border-width: 1px;
    border-radius: 4px;
}

.asset-status-summary,
.asset-status-metrics,
.asset-status-details {
    color: white;
    font-size: 12px;
    white-space: normal;
}

.asset-status-metrics {
    margin-top: 5px;
    color: var(--color-text-dim);
}

.asset-status-details {
    margin-top: 5px;
    color: var(--color-text-dim);
}

.hud-button {
    background-color: var(--btn-bg);
    border-color: var(--btn-border);
    border-width: 2px;
    border-radius: 3px;
    padding: 0;
    min-width: 100px;
    height: 28px;
    font-size: var(--font-size-sm);
    color: var(--color-text);
    -unity-text-align: middle-center;
}

.hud-button:hover {
    background-color: var(--btn-hover);
}

.hud-button.active {
    background-color: var(--color-accent);
    color: black;
}

.hud-stat {
    color: var(--color-text);
    font-size: var(--font-size-md);
    margin: 2px 0;
}

.hud-stat-label {
    color: var(--color-text-dim);
    font-size: var(--font-size-sm);
}

.hud-bar {
    background-color: rgba(40, 40, 40, 1);
    border-color: var(--btn-border);
    border-width: 1px;
    border-radius: 2px;
    height: 12px;
    width: 150px;
}

.hud-bar-fill {
    background-color: var(--color-accent);
    border-radius: 2px;
}

.hud-panel {
    position: absolute;
    top: 10px;
    left: 10px;
    width: 240px;
    padding: 12px;
    background-color: var(--color-panel-bg);
    border-color: var(--color-panel-border);
    border-width: 2px;
    flex-direction: column;
}

.hud-title-row {
    flex-direction: row;
    margin-bottom: 10px;
    align-items: center;
}

.hud-clan-button {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    padding: 0;
    margin-left: 4px;
    background-color: rgb(77, 77, 77);
    border-width: 1px;
    border-color: rgb(102, 102, 102);
}

.hud-panel .hud-title-row {
    flex-direction: row;
    margin-bottom: 4px;
}

.hud-panel .hud-nickname {
    font-size: var(--font-size-lg);
    -unity-font-style: bold;
    color: var(--color-accent);
    flex-grow: 1;
}

.hud-panel .hud-level {
    font-size: var(--font-size-lg);
    color: var(--color-text);
    margin-right: 2px;
}

.hud-panel .hud-separator {
    height: 1px;
    background-color: var(--color-text-dim);
    margin-bottom: 4px;
}

.hud-panel .hud-stat {
    font-size: var(--font-size-md);
    color: var(--color-text);
    margin: 0 0 2px;
}

.hud-panel .hud-money {
    -unity-font-style: bold;
    font-size: var(--font-size-md);
    color: rgb(0, 200, 0);
    margin: 0;
}

.hud-panel .hud-creds {
    -unity-font-style: bold;
    font-size: var(--font-size-md);
    color: rgb(200, 200, 0);
    margin: 0;
}

.hud-panel .hud-basket {
    -unity-font-style: bold;
    font-size: var(--font-size-md);
    color: var(--color-accent);
    margin-bottom: 2px;
}

.hud-basket-container {
    flex-direction: column;
}

.hud-stat-wrap {
    white-space: normal;
}

.hud-hp-bar {
    height: 14px;
    background-color: rgba(40, 40, 40, 1);
    border-radius: 3px;
    flex-direction: row;
    margin-bottom: 4px;
}

.hud-hp-fill {
    height: 14px;
    border-radius: 3px;
}

.hud-button-accent {
    background-color: var(--color-accent);
    border-color: var(--color-panel-border);
    border-width: 2px;
    border-radius: 3px;
    color: rgba(38, 38, 38, 1);
    font-size: var(--font-size-title);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
}

.hud-button-accent:hover {
    background-color: var(--color-accent-hover);
}

.hud-button-close {
    width: 24px;
    height: 24px;
    background-color: transparent;
    color: rgba(180, 180, 180, 1);
    font-size: 18px;
    padding: 0;
    border-width: 0;
}

.hud-button-claim {
    align-self: center;
    background-color: rgba(25, 100, 25, 1);
    color: white;
    border-color: rgba(40, 130, 40, 1);
    border-width: 2px;
    border-radius: 3px;
    padding: 4px 16px;
    font-size: var(--font-size-md);
}

.hud-button-claim:hover {
    background-color: rgba(50, 130, 50, 1);
}

.hud-button-label {
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    flex-grow: 1;
}

.hud-bonus-panel {
    position: absolute;
    top: 10px;
    left: 256px;
    width: 260px;
    padding: 10px;
    background-color: var(--color-panel-bg);
    border-color: var(--color-panel-border);
    border-width: 2px;
    flex-direction: column;
}

.hud-bonus-panel .hud-stat {
    margin: 2px 0;
}

.hud-bonus-panel .hud-title-row {
    flex-direction: row;
    margin-bottom: 10px;
}

.hud-bonus-panel .hud-title-row .hud-stat {
    color: var(--color-accent);
    flex-grow: 1;
}

.hud-status-panel {
    position: absolute;
    top: 10px;
    left: 256px;
    width: 220px;
    padding: 12px;
    background-color: var(--color-panel-bg);
    border-color: var(--color-panel-border);
    border-width: 2px;
    flex-direction: column;
}

.hud-status-line {
    font-size: var(--font-size-md);
    margin-bottom: 2px;
    white-space: normal;
}

.hud-skill-container {
    position: absolute;
    bottom: 10px;
    right: 10px;
    padding: 8px;
    flex-direction: column-reverse;
    align-items: flex-end;
}

.hud-skill-row {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 2px;
}

.hud-skill-icon {
    flex-direction: row;
    align-items: flex-end;
    margin-right: 4px;
    margin-bottom: 2px;
}

.hud-skill-icon-column {
    position: relative;
    flex-direction: column;
    align-items: center;
    width: 24px;
}

.hud-skill-arrow {
    position: absolute;
    top: -13px;
    left: 0;
    width: 24px;
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--color-accent);
    -unity-text-align: middle-center;
}

.hud-skill-bar-bg {
    width: 20px;
    height: 3px;
    background-color: rgba(60, 60, 60, 1);
    border-radius: 1px;
    margin-top: 1px;
}

.hud-skill-bar-fill {
    height: 3px;
    border-radius: 1px;
    background-color: rgb(0, 180, 0);
}

.hud-crystal-row {
    flex-direction: row;
    margin-bottom: 1px;
    align-items: center;
}

.hud-crystal-row .hud-stat {
    margin: 0 4px;
}

.hud-crystal-dot {
    width: 14px;
    height: 14px;
    margin-right: 6px;
    align-self: center;
}

.hud-crystal-label {
    font-size: 11px;
    color: var(--color-text);
}

.hud-skill-icon-image {
    width: 24px;
    height: 24px;
}

.hud-skill-bar-container {
    width: 6px;
    height: 24px;
    margin-left: 2px;
    flex-direction: column;
    justify-content: flex-end;
}

.hud-skill-bar-segment {
    width: 6px;
    height: 2px;
}

.hud-mission-panel {
    position: absolute;
    top: 50px;
    left: 50%;
    translate: -50% 0;
    min-width: 300px;
    padding: 8px;
    background-color: var(--color-panel-bg);
    border-color: var(--color-panel-border);
    border-width: 1px;
    flex-direction: column;
}

.hud-mission-title {
    color: var(--color-accent);
    margin-bottom: 4px;
}

.hud-mission-desc {
    margin-bottom: 8px;
}

.hud-mission-progress-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.hud-mission-progress-label {
    margin-right: 8px;
    min-width: 50px;
}

.hud-mission-progress-bar {
    flex-grow: 1;
    height: 16px;
    background-color: rgba(38, 38, 38, 1);
    border-radius: 3px;
}

.hud-mission-progress-fill {
    height: 16px;
    border-radius: 3px;
    background-color: rgb(179, 179, 51);
}

.hud-btn-action {
    position: absolute;
    background-color: rgba(25, 25, 38, 0.85);
    border-color: rgba(90, 90, 90, 1);
    border-width: 2px;
    border-radius: 3px;
    font-size: var(--font-size-sm);
    -unity-font-style: bold;
    color: var(--color-text);
    -unity-text-align: middle-center;
    padding: 0;
    height: 28px;
}

.hud-btn-action:hover {
    background-color: rgba(50, 50, 75, 0.85);
}

.hud-toggle-btn {
    position: absolute;
    left: 10px;
    background-color: rgba(38, 13, 13, 0.85);
}

.hud-toggle-btn:hover {
    background-color: rgba(64, 13, 13, 0.85);
}

.hud-toggle-btn-label {
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    flex-grow: 1;
    color: rgba(230, 77, 77, 1);
}

.hud-toggle-btn.enabled {
    background-color: rgba(13, 38, 13, 0.85);
}

.hud-toggle-btn.enabled:hover {
    background-color: rgba(13, 64, 13, 0.85);
}

.hud-toggle-btn-label.enabled {
    color: rgba(77, 230, 77, 1);
}

.hud-toggle-auto-dig { bottom: 281px; }
.hud-toggle-aggression { bottom: 314px; }
.hud-toggle-collision { bottom: 347px; }

.hud-btn-top-row {
    position: absolute;
    top: 10px;
    width: 100px;
    height: 28px;
}

.hud-bonus-button {
    position: absolute;
    left: 256px;
    top: 10px;
    width: 90px;
    height: 50px;
}

.hud-chat-button {
    position: absolute;
    left: 10px;
    bottom: 248px;
    width: 100px;
}

.hud-programmator-button {
    position: absolute;
    left: 10px;
    bottom: 215px;
    width: 100px;
}

/* ═══════════════════════════════════════════════════════════
   Sci-Fi Player HUD Styles
   ═══════════════════════════════════════════════════════════ */

.hud-top-left {
    position: absolute;
    top: 16px;
    left: 16px;
    width: 280px;
}

.hud-title-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
}

.hud-nickname {
    -unity-font-definition: var(--font-heading);
    color: var(--scifi-text-white);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
}

.hud-clan-btn {
    height: 24px;
    padding: 0 8px;
    font-size: 10px;
}

.hud-separator {
    height: 1px;
    background-color: var(--scifi-border-subtle);
    margin-bottom: 8px;
}

.hud-stat-group {
    margin-bottom: 8px;
}

.hud-stat-header {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 4px;
}

.hud-stat-title {
    -unity-font-definition: var(--font-body);
    color: var(--scifi-text-dim);
    font-size: 11px;
}

.hud-stat-percent {
    -unity-font-definition: var(--font-mono);
    color: var(--scifi-green);
    font-size: 11px;
    -unity-font-style: bold;
}

.hud-bar-track {
    height: 6px;
    margin-bottom: 6px;
}

.hud-currency-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 4px;
}

.hud-currency-item {
    flex-direction: row;
    align-items: center;
}

.hud-currency-icon {
    font-size: 14px;
    color: var(--scifi-cyan);
    margin-right: 4px;
}

.hud-currency-icon--gold {
    color: var(--scifi-gold);
}

.hud-currency-value {
    -unity-font-definition: var(--font-mono);
    color: var(--scifi-text-white);
    font-size: 12px;
    -unity-font-style: bold;
}

.hud-currency-value--gold {
    color: var(--scifi-gold-bright);
}

/* Корзина */
.hud-basket-panel {
    position: absolute;
    top: 170px;
    left: 16px;
    width: 140px;
    padding: 8px;
}

.hud-basket-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
    margin-bottom: 4px;
}

.hud-geology-text {
    -unity-font-definition: var(--font-body);
    color: var(--scifi-text-dim);
    font-size: 10px;
}

/* Миссия */
.hud-mission-panel {
    position: absolute;
    top: 16px;
    left: 50%;
    translate: -50% 0;
    width: 380px;
    padding: 10px 14px;
}

.hud-mission-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.hud-mission-title {
    -unity-font-definition: var(--font-heading);
    color: var(--scifi-text-white);
    font-size: 12px;
    -unity-font-style: bold;
    margin-left: 8px;
}

.hud-mission-desc {
    -unity-font-definition: var(--font-body);
    color: var(--scifi-text-dim);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 6px;
}

.hud-mission-track {
    height: 4px;
    margin-bottom: 4px;
}

#MissionProgressFill {
    width: 0%;
}

.hud-mission-progress-text {
    -unity-font-definition: var(--font-mono);
    color: var(--scifi-cyan);
    font-size: 10px;
    align-self: flex-end;
}

/* Правая колонка действий */
.hud-actions-column {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 160px;
}

.hud-action-btn {
    margin-bottom: 8px;
    width: 100%;
}

.hud-mode-led {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: var(--scifi-text-muted);
    margin-right: 8px;
}

.hud-mode-led--active {
    background-color: var(--scifi-cyan-bright);
}

/* Статусные линии (справа от панели игрока) */
.hud-status-container {
    position: absolute;
    top: 16px;
    left: 308px;
    width: 240px;
    flex-direction: column;
}

/* Панель бонусов (слева от колонки действий). left: auto обязателен:
   базовый .hud-bonus-panel из старой секции ставит left: 256px, и при
   заданных left+width+right переопределяется только один из трёх. */
.hud-bonus-panel {
    position: absolute;
    top: 16px;
    left: auto;
    right: 192px;
    width: 240px;
    padding: 12px;
}

/* ─── Системная миникарта (UI Toolkit) ─── */

.hud-minimap-panel {
    position: absolute;
    bottom: 16px;
    left: 16px;
    padding: 6px;
    background-color: rgba(14, 18, 26, 0.9);
    border-width: 1px;
    border-color: rgba(80, 140, 200, 0.5);
    border-radius: 6px;
    flex-direction: column;
    align-items: center;
}

.hud-minimap-container {
    width: 160px;
    height: 160px;
    border-width: 1px;
    border-color: rgba(60, 100, 150, 0.6);
    border-radius: 4px;
    overflow: hidden;
    background-color: rgb(0, 0, 0);
}

.hud-minimap-image {
    width: 100%;
    height: 100%;
}

.hud-minimap-coords {
    font-size: 11px;
    color: var(--scifi-cyan-bright, rgb(80, 200, 255));
    -unity-font-style: bold;
    margin-bottom: 4px;
    -unity-text-align: middle-center;
}
