/* ═══════════════════════════════════════════════════════════
   Fodinae Theme — единственный источник правды для стилей UI
   ═══════════════════════════════════════════════════════════ */

:root {
    /* ── Цвета ── */
    --color-panel-bg: rgba(20, 20, 20, 0.9);
    --color-panel-border: rgba(90, 90, 90, 1);
    --color-accent: rgba(178, 166, 128, 1);
    --color-accent-hover: rgba(204, 191, 153, 1);
    --color-text: white;
    --color-text-dim: rgba(180, 180, 180, 1);
    --color-danger: rgba(200, 60, 60, 1);
    --color-success: rgba(60, 180, 60, 1);

    /* ── Кнопки ── */
    --btn-bg: rgba(38, 38, 38, 1);
    --btn-hover: rgba(90, 90, 90, 1);
    --btn-border: rgba(102, 102, 102, 1);
    --btn-padding: 8px 20px;
    --btn-min-width: 180px;
    --btn-font-size: 14px;

    /* ── Размеры ── */
    --panel-padding: 12px;
    --panel-border-width: 2px;
    --cell-size: 50px;
    --cell-gap: 10px;
    --icon-size: 36px;

    /* ── Шрифты ── */
    --font-size-sm: 12px;
    --font-size-md: 14px;
    --font-size-lg: 16px;
    --font-size-xl: 20px;
}

/* ─── Полноэкранный root-контейнер UXML-клонов ─── */
/* CloneTree() возвращает TemplateContainer без высоты; класс вешается */
/* в коде на клон (tree.AddToClassList), чтобы он растянулся на панель. */
.ui-fullscreen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
}

.ui-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
}

/* ─── Единый контракт контейнеров ─── */

.ui-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
}

.ui-overlay--modal {
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.5);
}

.ui-overlay--blocking {
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.9);
}

.ui-overlay-message {
    padding: 40px;
    color: var(--color-text);
}

.ui-overlay-label {
    max-width: 900px;
    color: var(--color-text);
    font-size: var(--font-size-lg);
    white-space: normal;
    -unity-text-align: middle-center;
}

.ui-panel {
    flex-direction: column;
    min-height: 0;
    min-width: 0;
    flex-shrink: 1;
    overflow: hidden;
    background-color: var(--color-panel-bg);
    border-color: var(--color-panel-border);
    border-width: var(--panel-border-width);
    border-radius: 4px;
    padding: var(--panel-padding);
}

.ui-panel--modal {
    width: 70%;
    max-width: 520px;
    max-height: 85%;
}

.ui-panel__content,
.ui-scroll-viewport {
    width: 100%;
    min-width: 0;
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.ui-scroll-viewport {
    overflow: hidden;
}

.ui-content-column {
    flex-direction: column;
    min-width: 0;
    min-height: 0;
}

.ui-actions-row {
    flex-direction: row;
    flex-shrink: 0;
    justify-content: center;
}

/* ─── Главное меню (MainMenu) ─── */

.mm-root {
    flex-grow: 1;
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: rgba(10, 10, 10, 1);
}

.mm-loader {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: stretch;
    justify-content: center;
    background-color: rgba(10, 10, 10, 1);
}

.mm-loader-image {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.mm-menu {
    position: relative;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-top: 200px;
}

.mm-play-button {
    width: 200px;
    height: 48px;
    font-size: 20px;
    letter-spacing: 2px;
    background-color: var(--btn-bg);
    color: var(--color-text);
    border-width: 1px;
    border-color: var(--btn-border);
    border-radius: 4px;
}

.mm-play-button:hover {
    background-color: var(--btn-hover);
}

.mm-play-button:active {
    background-color: var(--color-accent);
}

/* ─── Индикатор загрузки (AssetLoadingIndicator) ─── */

.loadind-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.loadind-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 40px;
    background-color: rgba(0, 0, 0, 0.85);
}

.loadind-title {
    font-size: 24px;
    margin-bottom: 20px;
    -unity-text-align: middle-center;
}

.loadind-spinner {
    font-size: 48px;
    margin-bottom: 20px;
    -unity-text-align: middle-center;
}

.loadind-status {
    font-size: 14px;
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}

.loadind-progress {
    font-size: 12px;
    color: rgba(179, 179, 179, 1);
    -unity-text-align: middle-center;
}

/* ─── Стрелка миссии (MissionArrowUI) ─── */

.mission-arrow {
    position: absolute;
    width: 20px;
    height: 20px;
    background-color: rgba(255, 217, 0, 0.9);
}
