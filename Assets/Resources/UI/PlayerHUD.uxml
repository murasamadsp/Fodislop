<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="PlayerHUDRoot" class="hud-root" picking-mode="Ignore">

        <!-- ════════════ ВЕРХНЯЯ ЛЕВАЯ ПАНЕЛЬ: СТАТУС ИГРОКА ════════════ -->
        <ui:VisualElement name="PlayerStatusPanel" class="sci-fi-panel sci-fi-panel--tech hud-top-left">
            <!-- Верхняя строка: Никнейм, Уровень, Клан -->
            <ui:VisualElement class="hud-title-row">
                <ui:Label name="NicknameLabel" class="hud-nickname" text="---" />
                <ui:Label name="LevelLabel" class="sci-fi-badge-mono" text="УР. 0" />
                <ui:Button name="ClanButton" class="sci-fi-btn-cyan hud-clan-btn" text="КЛАН" tooltip="Клан" />
            </ui:VisualElement>

            <!-- Разделитель -->
            <ui:VisualElement class="hud-separator" />

            <!-- Прочность (HP) -->
            <ui:VisualElement class="hud-stat-group">
                <ui:VisualElement class="hud-stat-header">
                    <ui:Label name="HPLabel" class="hud-stat-title" text="ПРОЧНОСТЬ: 0 / 0" />
                    <ui:Label name="HPPercentLabel" class="hud-stat-percent" text="100%" />
                </ui:VisualElement>
                <ui:VisualElement class="sci-fi-bar-track hud-bar-track">
                    <ui:VisualElement name="HPBarFill" class="sci-fi-bar-fill-hp" style="width: 100%;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Валюта и Баланс -->
            <ui:VisualElement class="hud-currency-row">
                <ui:VisualElement class="hud-currency-item">
                    <ui:Label class="hud-currency-icon" text="⛃" />
                    <ui:Label name="MoneyLabel" class="hud-currency-value" text="0" />
                </ui:VisualElement>
                <ui:VisualElement class="hud-currency-item">
                    <ui:Label class="hud-currency-icon hud-currency-icon--gold" text="★" />
                    <ui:Label name="CredsLabel" class="hud-currency-value hud-currency-value--gold" text="0" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ════════════ ЛЕВАЯ КОЛОНКА: КОРЗИНА И КРИСТАЛЛЫ ════════════ -->
        <ui:VisualElement name="BasketPanel" class="sci-fi-panel hud-basket-panel">
            <ui:VisualElement class="hud-stat-header">
                <ui:Label class="hud-stat-title" text="КОРЗИНА" />
                <ui:Label name="BasketPercentLabel" class="sci-fi-badge-gold" text="0%" />
            </ui:VisualElement>
            <ui:VisualElement name="BasketContainer" class="hud-basket-grid" />
            <ui:Label name="GeologyLabel" class="hud-geology-text" text="Геология: 0" />
        </ui:VisualElement>

        <!-- ════════════ ВЕРХНЯЯ ПАНЕЛЬ: ТЕКУЩАЯ МИССИЯ ════════════ -->
        <ui:VisualElement name="MissionPanel" class="sci-fi-panel sci-fi-panel--tech hud-mission-panel" style="display: none;">
            <ui:VisualElement class="hud-mission-header">
                <ui:Label class="sci-fi-badge-gold" text="ЗАДАНИЕ" />
                <ui:Label name="MissionTitleLabel" class="hud-mission-title" text="---" />
            </ui:VisualElement>
            <ui:Label name="MissionDescLabel" class="hud-mission-desc" text="---" />
            <ui:VisualElement class="sci-fi-bar-track hud-mission-track">
                <ui:VisualElement name="MissionProgressFill" class="sci-fi-bar-fill-cyan" style="width: 0%;" />
            </ui:VisualElement>
            <ui:Label name="MissionProgressLabel" class="hud-mission-progress-text" text="0 / 0" />
        </ui:VisualElement>

        <!-- ════════════ ПРАВАЯ ПАНЕЛЬ КНОПОК И РЕЖИМОВ ════════════ -->
        <ui:VisualElement name="RightActionPanel" class="hud-actions-column">
            <!-- Авто-копка -->
            <ui:Button name="AutoDigButton" class="sci-fi-btn-dark hud-action-btn">
                <ui:VisualElement name="AutoDigIndicator" class="hud-mode-led" />
                <ui:Label name="AutoDigLabel" text="АВТО-КОПКА [E]" />
            </ui:Button>

            <!-- Агрессия -->
            <ui:Button name="AggressionButton" class="sci-fi-btn-dark hud-action-btn">
                <ui:VisualElement name="AggressionIndicator" class="hud-mode-led" />
                <ui:Label name="AggressionLabel" text="РЕЖИМ БОЯ [L]" />
            </ui:Button>

            <!-- Чат -->
            <ui:Button name="ChatButton" class="sci-fi-btn-dark hud-action-btn">
                <ui:Label text="ЧАТ [ENTER]" />
            </ui:Button>

            <!-- Бонус -->
            <ui:Button name="BonusButton" class="sci-fi-btn-gold hud-action-btn" style="display: none;">
                <ui:Label text="БОНУС!" />
            </ui:Button>
        </ui:VisualElement>

        <!-- ════════════ СТАТУСНЫЕ ЛИНИИ И ЭФФЕКТЫ ════════════ -->
        <ui:VisualElement name="StatusPanel" class="hud-status-container" />

        <!-- ════════════ НАВЫКИ И ПРОГРЕСС ════════════ -->
        <ui:VisualElement name="SkillContainer" class="hud-skill-container" />

    </ui:VisualElement>
</ui:UXML>
