<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="InventoryRoot" class="inv-root" picking-mode="Ignore">

        <!-- ════════════ УГЛОВАЯ ПАНЕЛЬ ════════════
             Одна панель в правом верхнем углу, как в старом клиенте: и короткий
             список, и полный показываются В НЕЙ ЖЕ, а не в отдельном окне
             посреди экрана. Полоса слева переключает одно на другое.

             InventoryRoot стоит в picking-mode="Ignore", чтобы пустое поле
             экрана не перехватывало клики мира; интерактивные элементы внутри
             ОБЯЗАНЫ явно вернуть picking-mode="Position" (паттерн как в
             ObserverJoystick.uxml) — иначе Ignore наследуется на всё поддерево
             и панель не получает мышь вовсе. -->
        <ui:VisualElement name="HotbarContainer" class="inv-hotbar" picking-mode="Position">
            <ui:Label name="InventoryTitle" class="inv-title" text="inventory.title" />
            <!-- Короткий список: девять слотов, генерируются в CreateCell -->
            <ui:VisualElement name="HotbarSlots" class="inv-hotbar-slots" picking-mode="Position" />

            <!-- Полный список: все слоты, та же раскладка, скрыт по умолчанию -->
            <ui:VisualElement name="InventoryGrid" class="inv-hotbar-slots is-hidden" picking-mode="Position" />

            <ui:Button name="InventoryToggleBtn" class="inv-toggle-btn" tooltip="inventory.open" picking-mode="Position">
                <ui:Label text="" />
            </ui:Button>
        </ui:VisualElement>

        <!-- ════════════ КАРТОЧКА ТУЛТИПА ПРЕДМЕТА ════════════ -->
        <ui:VisualElement name="ItemTooltipCard" class="sci-fi-panel inv-tooltip-card" style="display: none;">
            <ui:VisualElement class="inv-tooltip-header">
                <ui:Image name="TooltipIcon" class="inv-tooltip-icon" />
                <ui:VisualElement class="inv-tooltip-meta">
                    <ui:Label name="TooltipName" class="inv-tooltip-title" text="---" />
                    <ui:Label name="TooltipType" class="sci-fi-badge-gold" text="inventory.material" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="TooltipDesc" class="inv-tooltip-desc" text="---" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
