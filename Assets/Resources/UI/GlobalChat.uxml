<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="ChatPanel" class="gchat-panel">
        <ui:Label name="ChatHeader" class="gchat-header" text="Глобальный чат" />
        <ui:ScrollView name="ChatScroll" class="gchat-scroll" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" />
        <ui:VisualElement name="BottomRow" class="gchat-bottom-row">
            <ui:TextField name="ChatInput" class="gchat-input" />
            <ui:Button name="SendButton" class="gchat-send-button" text="&gt;" />
            <ui:Button name="ColorButton" class="gchat-color-button" />
        </ui:VisualElement>
        <ui:VisualElement name="ColorGrid" class="gchat-color-grid" style="display: none;" />
    </ui:VisualElement>
</ui:UXML>