#pragma kernel BloomPrefilter
#pragma kernel BloomDownsample
#pragma kernel BloomUpsample
#pragma kernel CompositeFinal

Texture2D<float4> _InputTex;
Texture2D<float4> _SourceTex;
Texture2D<float4> _BaseTex;
Texture2D<float4> _BloomTex;
Texture2D<float4> _VelocityTex;

RWTexture2D<float4> _DestTex;
RWTexture2D<float4> _OutputTex;

SamplerState sampler_LinearClamp;
SamplerState sampler_PointClamp;

float4 _ScreenSize; // x=width, y=height, z=1/width, w=1/height
float4 _SourceTexelSize; // xy=1/source size, zw=source size
float _BloomThreshold;
float _BloomScatter;
float4 _BloomTint;
float _BloomIntensity;

float _VignetteIntensity;
float4 _VignetteColor;
float _VignetteSmoothness;
float2 _VignetteCenter;

float _ChromaticAberrationIntensity;

float _Exposure;
float4 _ColorFilter;
float _Contrast;
float _Saturation;
int _ToneMappingEnabled;
float _ToneMappingWhitePoint;

float _EigengrauIntensity;
float4 _EigengrauColor;
float _EigengrauDarknessThreshold;
float _EigengrauNoiseScale;
float _EigengrauAnimationSpeed;
float _Time;

float _MotionBlurIntensity;
int _MotionBlurMaxSamples;

float Luminance(float3 color)
{
    return dot(color, float3(0.2126, 0.7152, 0.0722));
}

float LinearToPerceptual(float linearValue)
{
    linearValue = max(linearValue, 0.0);
    return linearValue <= 0.0031308
        ? linearValue * 12.92
        : 1.055 * pow(linearValue, 1.0 / 2.4) - 0.055;
}

float3 ToneMapHdrAces(float3 color, float whitePoint)
{
    // ACES fitted shoulder: HDR values are compressed continuously instead
    // of being divided by the brightest pixel or clipped per channel.
    const float a = 2.51;
    const float b = 0.03;
    const float c = 2.43;
    const float d = 0.59;
    const float e = 0.14;
    float3 mapped = (color * (a * color + b)) /
        (color * (c * color + d) + e);
    float white = max(whitePoint, 0.001);
    float whiteMapped = (white * (a * white + b)) /
        (white * (c * white + d) + e);
    return saturate(mapped / max(whiteMapped, 0.001));
}

float Hash31(float3 p)
{
    p = frac(p * float3(0.1031, 0.1030, 0.0973));
    p += dot(p, p.yzx + 33.33);
    return frac((p.x + p.y) * p.z);
}

float FilmGrain(float2 pixel)
{
    // Grain is defined directly in physical screen pixels. Old serialized
    // scale values are clamped here so they can never create giant cells.
    float grainSize = clamp(_EigengrauNoiseScale, 0.75, 2.0);
    float2 grainPixel = floor(pixel / grainSize);
    float frame = _Time * clamp(_EigengrauAnimationSpeed, 1.0, 60.0);
    float epoch = floor(frame);
    float phase = frac(frame);
    float blend = phase * phase * (3.0 - 2.0 * phase);

    float previous = Hash31(float3(grainPixel, epoch * 1.618 + 17.0));
    float next = Hash31(float3(grainPixel, (epoch + 1.0) * 1.618 + 17.0));
    return lerp(previous, next, blend) * 2.0 - 1.0;
}

float2 KeepLargerVelocity(float2 current, float2 candidate)
{
    return dot(candidate, candidate) > dot(current, current) ? candidate : current;
}

float2 SampleRobotVelocity(float2 uv)
{
    // Expand the robot mask by one physical pixel. Without this, a small
    // sprite only blurred its interior and the result was effectively
    // invisible at normal camera zoom.
    float2 texel = _ScreenSize.zw;
    float2 velocity = _VelocityTex.SampleLevel(sampler_LinearClamp, uv, 0).xy;
    velocity = KeepLargerVelocity(velocity, _VelocityTex.SampleLevel(sampler_LinearClamp, uv + float2( texel.x, 0.0), 0).xy);
    velocity = KeepLargerVelocity(velocity, _VelocityTex.SampleLevel(sampler_LinearClamp, uv + float2(-texel.x, 0.0), 0).xy);
    velocity = KeepLargerVelocity(velocity, _VelocityTex.SampleLevel(sampler_LinearClamp, uv + float2(0.0,  texel.y), 0).xy);
    velocity = KeepLargerVelocity(velocity, _VelocityTex.SampleLevel(sampler_LinearClamp, uv + float2(0.0, -texel.y), 0).xy);
    return velocity;
}

[numthreads(8, 8, 1)]
void BloomPrefilter(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_ScreenSize.x || id.y >= (uint)_ScreenSize.y) return;

    float2 uv = (id.xy + 0.5) * _ScreenSize.zw;
    float4 color = _InputTex.SampleLevel(sampler_LinearClamp, uv, 0);

    float lum = Luminance(color.rgb);
    float knee = max(_BloomThreshold * 0.5, 0.0001);
    float soft = clamp(lum - _BloomThreshold + knee, 0.0, 2.0 * knee);
    soft = soft * soft / (4.0 * knee + 0.0001);
    float contribution = max(lum - _BloomThreshold, soft) / max(lum, 0.0001);
    float3 brightColor = color.rgb * contribution;

    _DestTex[id.xy] = float4(brightColor * _BloomTint.rgb, color.a);
}

[numthreads(8, 8, 1)]
void BloomDownsample(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_ScreenSize.x || id.y >= (uint)_ScreenSize.y) return;

    float2 uv = (id.xy + 0.5) * _ScreenSize.zw;
    float2 texel = _SourceTexelSize.xy;

    // 3x3 Gaussian downsample. The old implementation used destination
    // texels here, skipped source pixels and produced a blocky pyramid.
    float4 color = _SourceTex.SampleLevel(sampler_LinearClamp, uv, 0) * 4.0;
    color += _SourceTex.SampleLevel(sampler_LinearClamp, uv + float2( texel.x, 0.0), 0) * 2.0;
    color += _SourceTex.SampleLevel(sampler_LinearClamp, uv + float2(-texel.x, 0.0), 0) * 2.0;
    color += _SourceTex.SampleLevel(sampler_LinearClamp, uv + float2(0.0,  texel.y), 0) * 2.0;
    color += _SourceTex.SampleLevel(sampler_LinearClamp, uv + float2(0.0, -texel.y), 0) * 2.0;
    color += _SourceTex.SampleLevel(sampler_LinearClamp, uv + float2( texel.x,  texel.y), 0);
    color += _SourceTex.SampleLevel(sampler_LinearClamp, uv + float2(-texel.x,  texel.y), 0);
    color += _SourceTex.SampleLevel(sampler_LinearClamp, uv + float2( texel.x, -texel.y), 0);
    color += _SourceTex.SampleLevel(sampler_LinearClamp, uv + float2(-texel.x, -texel.y), 0);
    color *= 1.0 / 16.0;

    _DestTex[id.xy] = color;
}

[numthreads(8, 8, 1)]
void BloomUpsample(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_ScreenSize.x || id.y >= (uint)_ScreenSize.y) return;

    float2 uv = (id.xy + 0.5) * _ScreenSize.zw;
    float2 texel = _SourceTexelSize.xy;
    float4 highRes = _BaseTex.SampleLevel(sampler_LinearClamp, uv, 0);

    // 3x3 tent reconstruction prevents individual pyramid levels from
    // showing through as square bands around bright sprites.
    float4 lowRes = _SourceTex.SampleLevel(sampler_LinearClamp, uv, 0) * 4.0;
    lowRes += _SourceTex.SampleLevel(sampler_LinearClamp, uv + float2( texel.x, 0.0), 0) * 2.0;
    lowRes += _SourceTex.SampleLevel(sampler_LinearClamp, uv + float2(-texel.x, 0.0), 0) * 2.0;
    lowRes += _SourceTex.SampleLevel(sampler_LinearClamp, uv + float2(0.0,  texel.y), 0) * 2.0;
    lowRes += _SourceTex.SampleLevel(sampler_LinearClamp, uv + float2(0.0, -texel.y), 0) * 2.0;
    lowRes += _SourceTex.SampleLevel(sampler_LinearClamp, uv + float2( texel.x,  texel.y), 0);
    lowRes += _SourceTex.SampleLevel(sampler_LinearClamp, uv + float2( texel.x, -texel.y), 0);
    lowRes += _SourceTex.SampleLevel(sampler_LinearClamp, uv + float2(-texel.x,  texel.y), 0);
    lowRes += _SourceTex.SampleLevel(sampler_LinearClamp, uv + float2(-texel.x, -texel.y), 0);
    lowRes *= 1.0 / 16.0;

    _DestTex[id.xy] = highRes + lowRes * _BloomScatter;
}

[numthreads(8, 8, 1)]
void CompositeFinal(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_ScreenSize.x || id.y >= (uint)_ScreenSize.y) return;

    float2 uv = (id.xy + 0.5) * _ScreenSize.zw;

    // 1. Chromatic Aberration
    // Alpha was previously discarded here and the final write below hardcoded
    // 1.0 - harmless for the opaque gameplay camera, but it meant any camera
    // relying on this pass for a transparent composite (e.g. an offscreen UI
    // render) always came out as a solid opaque block regardless of its own
    // clear settings.
    float3 color;
    float srcAlpha = _InputTex.SampleLevel(sampler_PointClamp, uv, 0).a;
    if (_ChromaticAberrationIntensity > 0.001)
    {
        float2 distFromCenter = uv - float2(0.5, 0.5);
        float2 offset = distFromCenter * _ChromaticAberrationIntensity * 0.02;

        float r = _InputTex.SampleLevel(sampler_PointClamp, uv - offset, 0).r;
        float g = _InputTex.SampleLevel(sampler_PointClamp, uv, 0).g;
        float b = _InputTex.SampleLevel(sampler_PointClamp, uv + offset, 0).b;
        color = float3(r, g, b);
    }
    else
    {
        color = _InputTex.SampleLevel(sampler_PointClamp, uv, 0).rgb;
    }

    // 2. Motion Blur (if velocity texture present and intensity > 0)
    if (_MotionBlurIntensity > 0.001 && _MotionBlurMaxSamples > 1)
    {
        float2 vel = SampleRobotVelocity(uv) * _MotionBlurIntensity;
        if (length(vel) > 0.0001)
        {
            float3 accumulated = color;
            float accumulatedWeight = 1.0;
            int samples = clamp(_MotionBlurMaxSamples, 2, 32);
            for (int i = 1; i < samples; i++)
            {
                float2 sampleUV = clamp(uv - vel * ((float)i / (float)samples), float2(0, 0), float2(1, 1));
                float2 sampleVelocity = _VelocityTex.SampleLevel(sampler_LinearClamp, sampleUV, 0).xy;
                float velocityAgreement = dot(sampleVelocity, vel) / max(dot(vel, vel), 0.0000001);
                float sampleWeight = step(0.5, velocityAgreement);
                accumulated += _InputTex.SampleLevel(sampler_PointClamp, sampleUV, 0).rgb * sampleWeight;
                accumulatedWeight += sampleWeight;
            }
            color = accumulated / accumulatedWeight;
        }
    }

    // 3. Bloom Composition
    if (_BloomIntensity > 0.001)
    {
        float3 bloom = _BloomTex.SampleLevel(sampler_LinearClamp, uv, 0).rgb;
        color += bloom * _BloomIntensity;
    }

    // 4. Color Grading. Every neutral value is an exact no-op.
    color *= exp2(_Exposure) * _ColorFilter.rgb;

    // Contrast
    if (abs(_Contrast) > 0.001)
    {
        color = (color - 0.5) * (1.0 + _Contrast) + 0.5;
    }

    // Saturation
    if (abs(_Saturation - 1.0) > 0.001)
    {
        float lum = Luminance(color);
        color = lerp(float3(lum, lum, lum), color, _Saturation);
    }
    color = max(0.0, color);

    // 5. Vignette
    if (_VignetteIntensity > 0.001)
    {
        float aspect = _ScreenSize.x / max(_ScreenSize.y, 1.0);
        float2 centeredUv = (uv - _VignetteCenter) * float2(aspect, 1.0);
        float distanceFromCenter = length(centeredUv);
        float feather = max(_VignetteSmoothness, 0.001);
        float edgeMask = smoothstep(0.5 - feather * 0.5, 0.5 + feather * 0.5, distanceFromCenter);
        color = lerp(color, _VignetteColor.rgb, saturate(edgeMask * _VignetteIntensity));
    }

    // Convert the HDR world/bloom result into a stable SDR range before
    // display-referred film grain using a dynamic shoulder curve.
    if (_ToneMappingEnabled != 0)
    {
        color = ToneMapHdrAces(max(color, 0.0), _ToneMappingWhitePoint);
    }

    // 6. Eigengrau: fine, zero-mean film grain in dark areas. This is not a
    // bright overlay and contains no low-frequency or scrolling texture.
    if (_EigengrauIntensity > 0.001)
    {
        // The camera target is linear. Darkness Threshold is exposed in
        // perceptual space; comparing it directly to linear luminance made
        // ordinary lit pixels look "dark" and spread grain over the screen.
        float perceptualLuminance = LinearToPerceptual(Luminance(color));
        float threshold = max(_EigengrauDarknessThreshold, 0.0001);
        float darkness = 1.0 - smoothstep(threshold * 0.2, threshold, perceptualLuminance);
        darkness = darkness * darkness * darkness;

        float grain = FilmGrain(id.xy + 0.5);
        float amplitude = 0.01 * saturate(_EigengrauIntensity) * darkness;
        float maxTint = max(max(_EigengrauColor.r, _EigengrauColor.g), _EigengrauColor.b);
        float3 grainTint = maxTint > 0.0001
            ? lerp(float3(1.0, 1.0, 1.0), _EigengrauColor.rgb / maxTint, 0.35)
            : float3(1.0, 1.0, 1.0);
        color = max(0.0, color + grain * amplitude * grainTint);
    }

    _OutputTex[id.xy] = float4(color, srcAlpha);
}
