  "snapshot": false,
  "provider": {
    "modal": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Modal",
      "options": {
        "baseURL": "https://inference.us-west.modal.direct/v1",
        "apiKey": "wk-JABtwfsQjFuUq9s0mKOmyS.ws-ByeGqaT5odi8sgBmXJMN1e"
      },
      "models": {
        "murasama-off--ep-kimi-k3-server.us-west.modal.direct": {
          "name": "Kimi K3",
