{
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.compactFolders": false,
  "explorer.fileNesting.patterns": {
    "*": "$(capture).meta",
    "*.cs": "$(capture).g.cs, $(capture).designer.cs, $(capture).generated.cs",
    "*.uxml": "$(capture).uss, $(capture).uxml.cs, $(capture).tss",
    "*.prefab": "$(capture).prefab.meta",
    "*.unity": "$(capture).unity.meta",
    "*.sln": "*.slnx, *.csproj",
    "*.slnx": "*.csproj, *.sln",
    "package.json": "package-lock.json, .yarnrc*, yarn.lock, .npmrc",
    "README*": "AUTHORS, BACKERS*, CHANGELOG*, CITATION*, CODE_OF_CONDUCT*, CONTRIBUTING*, CONTRIBUTORS, DESIGN*, LICENSE*, OPT-IN*, OPT-OUT*, README*, TRADEMARK*, SECURITY*"
  },
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.formatOnSave": true,
  "files.eol": "\n",
  "files.encoding": "utf8",
  "editor.trimAutoWhitespace": true,
  "files.associations": {
    "*.uxml": "xml",
    "*.uss": "css",
    "*.tss": "css",
    "*.compute": "hlsl",
    "*.shader": "hlsl",
    "*.cginc": "hlsl",
    "*.hlsl": "hlsl",
    "*.asmdef": "json",
    "*.asmref": "json",
    "*.csproj": "xml",
    "*.props": "xml",
    "*.targets": "xml",
    "*.slnx": "xml",
    "*.inputactions": "json"
  },
  "files.watcherExclude": {
    "**/Library/**": true,
    "**/Temp/**": true,
    "**/obj/**": true,
    "**/Build/**": true,
    "**/Logs/**": true,
    "**/ProfilerCaptures/**": true,
    "**/.vs/**": true,
    "**/.git/**": true,
    "**/UserSettings/**": true,
    "**/KernAudio/.cache/**": true,
    "**/*.meta": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/Library": true,
    "**/Temp": true,
    "**/obj": true,
    "**/Build": true,
    "**/Logs": true,
    "**/ProfilerCaptures": true,
    "**/.vs": true,
    "**/UserSettings": true,
    "**/*.meta": true
  },
  "search.exclude": {
    "**/Library": true,
    "**/Temp": true,
    "**/obj": true,
    "**/Build": true,
    "**/Logs": true,
    "**/ProfilerCaptures": true,
    "**/.vs": true,
    "**/*.meta": true,
    "**/*.mapb": true,
    "**/*.bytes": true,
    "**/UserSettings": true
  },
  "editor.minimap.enabled": false,
  "editor.rulers": [120,
    160
  ],
  "editor.renderWhitespace": "selection",
  "editor.stickyScroll.enabled": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.linkedEditing": true,
  "editor.suggestSelection": "first",
  "editor.parameterHints.enabled": true,
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.unicodeHighlight.invisibleCharacters": false,
  "files.autoGuessEncoding": false,
  "files.simpleDialog.enable": true,
  "files.hotExit": "onExitAndWindowClose",
  "git.openRepositoryInParentFolders": "never",
  "git.mergeEditor": true,
  "git.autofetch": false,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.confirmOnExit": "hasChildProcesses",
  "csharp.semanticHighlighting.enabled": true,
  "csharp.format.enable": true,
  "dotnet.backgroundAnalysis.analyzerDiagnosticsScope": "openFiles",
  "dotnet.defaultSolution": "Fodislop.slnx",
  "csharp.analyzerDiagnosticScope": "openFiles",
  "csharp.enableImportCompletion": true,
  "csharp.enableEditorConfigSupport": true,
  "csharp.suppressHiddenDiagnostics": false,
  "dotnet.server.useOmnisharp": false,
  "vstuc.useInfiniteLoopTimeout": true,
  "dotnet.codeLens.enableReferencesCodeLens": true
}
