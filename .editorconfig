# EditorConfig — https://editorconfig.org

root = true

# Все файлы
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# C# — Unity-стиль
[*.cs]
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_space_after_cast = false
csharp_prefer_braces = true

# Использование var (не заставляем var на int/float/string/bool примитивах)
dotnet_style_predefined_type_for_member_access_keyword_state = true:suggestion
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:silent

# Expression-bodied members (короткий синтаксис =>)
csharp_style_expression_bodied_methods = true:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion

# Pattern matching
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion

# ── Правила именования (Naming Conventions) ───────────────────────────────
# Интерфейсы должны начинаться с I (IPascalCase)
dotnet_naming_rule.interface_should_be_begun_with_i.severity = suggestion
dotnet_naming_rule.interface_should_be_begun_with_i.symbols = interface_symbols
dotnet_naming_rule.interface_should_be_begun_with_i.style = begun_with_i_style

dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_symbols.interface_symbols.applicable_accessibilities = *

dotnet_naming_style.begun_with_i_style.required_prefix = I
dotnet_naming_style.begun_with_i_style.capitalization = pascal_case

# Приватные/защищенные поля (НЕ константы) должны начинаться с _ и быть camelCase (_camelCase)
dotnet_naming_rule.private_members_with_underscore.severity = suggestion
dotnet_naming_rule.private_members_with_underscore.symbols = private_fields
dotnet_naming_rule.private_members_with_underscore.style = prefix_underscore

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, protected
dotnet_naming_symbols.private_fields.disabled_modifiers = const

dotnet_naming_style.prefix_underscore.required_prefix = _
dotnet_naming_style.prefix_underscore.capitalization = camel_case

# Публичные/внутренние поля (НЕ константы) должны быть PascalCase
dotnet_naming_rule.public_fields_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.public_fields_should_be_pascal_case.symbols = public_fields
dotnet_naming_rule.public_fields_should_be_pascal_case.style = pascal_case_style

dotnet_naming_symbols.public_fields.applicable_kinds = field
dotnet_naming_symbols.public_fields.applicable_accessibilities = public, internal, friend
dotnet_naming_symbols.public_fields.disabled_modifiers = const

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# Типы (классы, структуры, перечисления), свойства и методы должны быть PascalCase
dotnet_naming_rule.types_and_members_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.types_and_members_should_be_pascal_case.symbols = types_and_members
dotnet_naming_rule.types_and_members_should_be_pascal_case.style = pascal_case_style

dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, enum, property, method, event
dotnet_naming_symbols.types_and_members.applicable_accessibilities = *

# Локальные переменные и параметры должны быть camelCase
dotnet_naming_rule.locals_should_be_camel_case.severity = suggestion
dotnet_naming_rule.locals_should_be_camel_case.symbols = locals_and_parameters
dotnet_naming_rule.locals_should_be_camel_case.style = camel_case_style

dotnet_naming_symbols.locals_and_parameters.applicable_kinds = local, parameter

dotnet_naming_style.camel_case_style.capitalization = camel_case

# ── Линтер: StyleCop (SA) ──────────────────────────────────────────────────
# Намеренные послабления стиля (не дефекты): file header, XML-доки,
# this.-префикс, _, SNAKE_CASE, порядок членов и туплы не считаем ошибкой.
dotnet_diagnostic.SA1633.severity = none   # Нет file header
dotnet_diagnostic.SA1101.severity = none   # Не требуем this. prefix (стиль)
dotnet_diagnostic.SA1200.severity = none   # using вне namespace — ок
dotnet_diagnostic.SA1309.severity = none   # _underscore поля разрешены
dotnet_diagnostic.SA1310.severity = none   # Подчёркивания (_) в полях/константах
dotnet_diagnostic.SA1312.severity = none   # UPPER_SNAKE_CASE для локальных констант
dotnet_diagnostic.SA1108.severity = none   # Block statements with embedded comments
dotnet_diagnostic.SA1117.severity = none   # Parameter placement on same line
dotnet_diagnostic.SA1316.severity = none   # Tuple element names casing
dotnet_diagnostic.SA1414.severity = none   # Tuple types signature element names
dotnet_diagnostic.SA1512.severity = none   # Одиночный комментарий разрешён
dotnet_diagnostic.SA1516.severity = none   # Пустые строки между элементами не обязательны
dotnet_diagnostic.SA1600.severity = none   # XML-доки не обязательны
dotnet_diagnostic.SA1601.severity = none
dotnet_diagnostic.SA1602.severity = none
dotnet_diagnostic.SA1604.severity = none
dotnet_diagnostic.SA1611.severity = none
dotnet_diagnostic.SA1615.severity = none
dotnet_diagnostic.SA1618.severity = none
dotnet_diagnostic.SA1623.severity = none
dotnet_diagnostic.SA1642.severity = none
dotnet_diagnostic.SA1643.severity = none
dotnet_diagnostic.SA1313.severity = none   # Parameter casing (стиль)
dotnet_diagnostic.SA1507.severity = none   # Multiple blank lines in a row
dotnet_diagnostic.SA1201.severity = none   # Type/field ordering
dotnet_diagnostic.SA1202.severity = none   # Member ordering (public before private)
dotnet_diagnostic.SA1203.severity = none   # Constant field ordering
dotnet_diagnostic.SA1204.severity = none   # Static member ordering
dotnet_diagnostic.SA1214.severity = none   # Readonly field ordering

# ── Линтер: NetAnalyzers (CA) ─────────────────────────────────────────────
# Unity-специфичные none остаются: движок гарантирует null / инжектит поля.
dotnet_diagnostic.CA1062.severity = none   # Unity объекты — null уже гарантирует движок
dotnet_diagnostic.CA1303.severity = none   # Не локализуем строки
dotnet_diagnostic.CA1304.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1307.severity = none
dotnet_diagnostic.CA1310.severity = none
dotnet_diagnostic.CA2007.severity = none   # ConfigureAwait — UniTask не требует
dotnet_diagnostic.CA1031.severity = error   # Не глотать все исключения → ОШИБКА
dotnet_diagnostic.CA1051.severity = error   # Не публичные поля → ОШИБКА

# ── Dead code detection (утяжелено до ОШИБКИ) ──────────────────────────────
dotnet_diagnostic.IDE0051.severity = error   # Неиспользуемые приватные члены → ОШИБКА
dotnet_diagnostic.IDE0052.severity = error   # Неиспользуемые приватные поля → ОШИБКА
dotnet_diagnostic.CA1823.severity = error    # Неиспользуемые приватные поля → ОШИБКА
dotnet_diagnostic.CA1822.severity = error    # Метод может быть static → ОШИБКА

# ── Линтер: Roslynator (RCS) ─────────────────────────────────────────────
dotnet_diagnostic.RCS1036.severity = none     # Blank lines (стиль)
dotnet_diagnostic.RCS1037.severity = error    # Trailing whitespace в комментарии → ОШИБКА
dotnet_diagnostic.RCS1118.severity = error    # Неиспользуемый параметр → ОШИБКА
dotnet_diagnostic.RCS1138.severity = none     # XML-доки не обязательны
dotnet_diagnostic.RCS1139.severity = none

# ── Линтер: SonarAnalyzer (S) ─────────────────────────────────────────────
# Unity-коллбеки (S1172/S1186/S101) остаются none: подпись задаёт движок.
dotnet_diagnostic.S101.severity = none      # Type naming (стиль)
dotnet_diagnostic.S108.severity = error     # Empty block — пустой catch/if → ОШИБКА
dotnet_diagnostic.S125.severity = warning   # Commented out code → warning
dotnet_diagnostic.S1066.severity = warning  # Merge if statements

dotnet_diagnostic.S1172.severity = none     # Unused parameters (Unity callbacks)
dotnet_diagnostic.S1186.severity = none     # Empty methods (Unity callbacks)

dotnet_diagnostic.S1481.severity = error    # Unused local variables → ОШИБКА
dotnet_diagnostic.S1854.severity = error    # Useless assignment → ОШИБКА
dotnet_diagnostic.S1905.severity = warning  # Unnecessary cast
dotnet_diagnostic.S2183.severity = warning  # Shift by 0
dotnet_diagnostic.S2234.severity = warning  # Parameter name ordering
dotnet_diagnostic.S2292.severity = warning  # Auto property
dotnet_diagnostic.S2344.severity = warning  # Flags suffix
dotnet_diagnostic.S2583.severity = error    # Unreachable condition → ОШИБКА
dotnet_diagnostic.S2589.severity = error    # Constant condition → ОШИБКА
dotnet_diagnostic.S2743.severity = warning  # Generic static field
dotnet_diagnostic.S2933.severity = error    # Readonly field можно сделать readonly → ОШИБКА
dotnet_diagnostic.S3218.severity = warning  # Member shadowing
dotnet_diagnostic.S3264.severity = error    # Unused event → ОШИБКА
dotnet_diagnostic.S3358.severity = warning  # Nested ternary
dotnet_diagnostic.S3458.severity = warning  # Empty case
dotnet_diagnostic.S3878.severity = warning  # Array creation params
dotnet_diagnostic.S3881.severity = error    # IDisposable pattern → ОШИБКА
dotnet_diagnostic.S3903.severity = warning  # Named namespace for types
dotnet_diagnostic.S4070.severity = warning  # Flags attribute
dotnet_diagnostic.S4136.severity = warning  # Method overloads adjacent
dotnet_diagnostic.S6602.severity = warning  # Find vs FirstOrDefault
dotnet_diagnostic.S6603.severity = warning  # TrueForAll vs All
dotnet_diagnostic.S6605.severity = warning  # Exists vs Any

# ── Линтер: Unity Analyzers (UNT) ────────────────────────────────────────
# Исключения и кастомные переопределения для Unity (остаются none — ложные срабатывания).
dotnet_diagnostic.UNT0005.severity = none     # [retired] Time.deltaTime в FixedUpdate
dotnet_diagnostic.UNT0007.severity = none     # Unity null coalescing check
dotnet_diagnostic.UNT0008.severity = none     # Unity null propagation check
dotnet_diagnostic.UNT0017.severity = none     # SetPixels vs SetPixels32
dotnet_diagnostic.UNT0021.severity = none     # Unity-сообщения (Start, Awake) не обязаны быть protected
dotnet_diagnostic.UNT0034.severity = none     # Vector3 -> Vector2 не спамить подсказкой
dotnet_diagnostic.UNT0035.severity = none     # Vector2 -> Vector3 не спамить подсказкой
dotnet_diagnostic.UNT0042.severity = none     # Mesh array access in loop — слишком шумно
dotnet_diagnostic.UNT0043.severity = error    # Опечатка в conditional compilation symbol в НАШЕМ коде → ОШИБКА

# Vendored VContainer — полностью отключаем внешние анализаторы
[Assets/Scripts/VContainer/**/*.cs]
dotnet_diagnostic.SA*.severity = none
dotnet_diagnostic.CA*.severity = none
dotnet_diagnostic.RCS*.severity = none
dotnet_diagnostic.S*.severity = none
dotnet_diagnostic.UNT*.severity = none

# Vendored third-party code (UniTask под Assets/Plugins) — не наш код,
# внешние анализаторы подавляем: иначе ловим ложные срабатывания
# (свои символы компиляции NETSTANDARD2_0, UNITY_PS4, сигнатуры колбеков).
# Наш код (Assets/Scripts, Assets/Editor) наследует строгие правила из [*.cs].
[Assets/Plugins/**/*.cs]
dotnet_diagnostic.SA*.severity = none
dotnet_diagnostic.CA*.severity = none
dotnet_diagnostic.RCS*.severity = none
dotnet_diagnostic.S*.severity = none
dotnet_diagnostic.UNT*.severity = none
dotnet_diagnostic.UNT0043.severity = none
dotnet_diagnostic.UNT0006.severity = none

# Third-party packages — подавляем warnings от чужого кода
[Packages/**/*.cs]
dotnet_diagnostic.CS0109.severity = none   # 'new' keyword not required
dotnet_diagnostic.CS0618.severity = none   # Obsolete API usage
dotnet_diagnostic.UAC1001.severity = none  # Missing [Serializable]
dotnet_diagnostic.SA*.severity = none
dotnet_diagnostic.CA*.severity = none
dotnet_diagnostic.RCS*.severity = none
dotnet_diagnostic.S*.severity = none
dotnet_diagnostic.UNT*.severity = none
dotnet_diagnostic.UNT0043.severity = none
dotnet_diagnostic.UNT0006.severity = none

# Шейдеры
[*.{shader,hlsl,cginc,compute}]
indent_size = 4

# Unity YAML (сцены, префабы, ассеты)
[*.{unity,prefab,asset,mat,anim,controller,mask}]
indent_size = 2
trim_trailing_whitespace = false

# UI Toolkit
[*.{uxml,uss}]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false

# JSON
[*.json]
indent_size = 2
