<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Стиль проверяется в Unity и линтером; здесь чужие файлы игры собираются только ради замеров. -->
    <RunAnalyzers>false</RunAnalyzers>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ScriptAssemblies>../../Library/ScriptAssemblies</ScriptAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Данные сервера: Unity собирает их сам, ссылаются только на mscorlib. -->
    <Reference Include="MinesServer.Data">
      <HintPath Condition="Exists('$(ScriptAssemblies)/MinesServer.Data.dll')">$(ScriptAssemblies)/MinesServer.Data.dll</HintPath>
      <HintPath Condition="!Exists('$(ScriptAssemblies)/MinesServer.Data.dll')">../lib/MinesServer.Data.dll</HintPath>
    </Reference>
    <Reference Include="MinesServer.Networking">
      <HintPath Condition="Exists('$(ScriptAssemblies)/MinesServer.Networking.dll')">$(ScriptAssemblies)/MinesServer.Networking.dll</HintPath>
      <HintPath Condition="!Exists('$(ScriptAssemblies)/MinesServer.Networking.dll')">../lib/MinesServer.Networking.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Настоящие файлы игры, без копий: бенчмарк меряет тот же код. -->
    <Compile Include="../../Assets/Scripts/Core/Interfaces/Contracts/ProjectRuntimeContracts.cs" Link="Game/ProjectRuntimeContracts.cs" />
    <Compile Include="../../Assets/Scripts/Core/Interfaces/Contracts/Settings/TerrainSettings.cs" Link="Game/TerrainSettings.cs" />
    <Compile Include="../../Assets/Scripts/Core/Configuration/Contracts/SettingAttributes.cs" Link="Game/SettingAttributes.cs" />
    <Compile Include="../../Assets/Scripts/Rendering/PostProcessing/ColorGrading/Contracts/VisualTuning.cs" Link="Game/VisualTuning.cs" />
    <Compile Include="../../Assets/Scripts/World/Lighting/Quality/Contracts/LightingQualityTuning.cs" Link="Game/LightingQualityTuning.cs" />
    <Compile Include="../../Assets/Scripts/World/Common/CoordinateUtils.cs" Link="Game/CoordinateUtils.cs" />
    <!-- Старый формат вершины — точка отсчёта для сравнения с буфером клеток. -->
    <Compile Include="../../Assets/Scripts/Tests/Editor/World/Terrain/Reference/TerrainVertex.cs" Link="Reference/TerrainVertex.cs" />
    <Compile Include="../../Assets/Scripts/World/Terrain/GPU/TerrainCellData.cs" Link="Game/TerrainCellData.cs" />
    <Compile Include="../../Assets/Scripts/World/Terrain/GPU/TerrainCellFormat.cs" Link="Game/TerrainCellFormat.cs" />
    <Compile Include="../../Assets/Scripts/World/Terrain/GPU/TerrainCellTypeSet.cs" Link="Game/TerrainCellTypeSet.cs" />
    <Compile Include="../../Assets/Scripts/World/Terrain/GPU/TerrainDirtyRegion.cs" Link="Game/TerrainDirtyRegion.cs" />
    <Compile Include="../../Assets/Scripts/World/Terrain/Cache/DirtyRectSet.cs" Link="Game/DirtyRectSet.cs" />
    <Compile Include="../../Assets/Scripts/World/Terrain/Cache/TerrainCellRegion.cs" Link="Game/TerrainCellRegion.cs" />
    <Compile Include="../../Assets/Scripts/World/Terrain/Cache/TerrainRingGrid.cs" Link="Game/TerrainRingGrid.cs" />
    <Compile Include="../../Assets/Scripts/World/Terrain/Cache/TerrainScrollBands.cs" Link="Game/TerrainScrollBands.cs" />
    <Compile Include="../../Assets/Scripts/World/Terrain/Cache/TerrainResidencyProbe.cs" Link="Game/TerrainResidencyProbe.cs" />
    <Compile Include="../../Assets/Scripts/World/Terrain/Core/TerrainWindowAdvance.cs" Link="Game/TerrainWindowAdvance.cs" />
    <Compile Include="../../Assets/Scripts/World/Terrain/Cache/TerrainMetadata.cs" Link="Game/TerrainMetadata.cs" />
    <Compile Include="../../Assets/Scripts/World/Terrain/Cache/TerrainCellDataSource.cs" Link="Game/TerrainCellDataSource.cs" />
    <Compile Include="../../Assets/Scripts/World/Common/Contracts/ISpatialIndex.cs" Link="Game/ISpatialIndex.cs" />
    <Compile Include="../../Assets/Scripts/World/Common/Spatial/SpatialShardGrid.cs" Link="Game/SpatialShardGrid.cs" />
    <!-- Маски и искажение читают TerrainCellCache: его заменяет Game/BenchTerrainCellCache.cs. -->
    <Compile Include="../../Assets/Scripts/World/Common/TileBitmaskConverter.cs" Link="Game/TileBitmaskConverter.cs" />
    <Compile Include="../../Assets/Scripts/World/Terrain/Mesh/TerrainVertexDistortionCalculator.cs" Link="Game/TerrainVertexDistortionCalculator.cs" />
    <Compile Include="../../Assets/Scripts/World/Common/Contracts/RenderingConstants.cs" Link="Game/RenderingConstants.cs" />
    <Compile Include="../../Assets/Scripts/World/Common/Contracts/BlockDefinition.cs" Link="Game/BlockDefinition.cs" />
    <Compile Include="../../Assets/Scripts/World/Common/Contracts/IBlockRegistry.cs" Link="Game/IBlockRegistry.cs" />
    <Compile Include="../../Assets/Scripts/World/Common/Contracts/CellVisualProtocol.cs" Link="Game/CellVisualProtocolContracts.cs" />
    <Compile Include="../../Assets/Scripts/World/Common/MapBlockColors.cs" Link="Game/MapBlockColors.cs" />
    <Compile Include="../../Assets/Scripts/World/Storage/BlockRegistry.cs" Link="Game/BlockRegistry.cs" />
    <Compile Include="../../Assets/Scripts/World/Storage/MapCellConfigCatalog.cs" Link="Game/MapCellConfigCatalog.cs" />
    <!-- Каталоги типов: FillQuad опрашивает их на каждый квад. -->
  </ItemGroup>
</Project>
