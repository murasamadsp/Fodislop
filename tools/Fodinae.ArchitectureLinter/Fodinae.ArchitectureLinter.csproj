<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <AnalysisLevel>none</AnalysisLevel>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fodinae-archlint</ToolCommandName>
    <PackageId>Fodinae.ArchitectureLinter</PackageId>
    <Version>1.0.0</Version>
    <Authors>Fodinae</Authors>
    <Description>Fodinae architecture linter — forbidden API, dead members, settings wiring, localization, USS, shader invariants.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/...</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.4" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\architecture-rules.html" Pack="true" PackagePath="docs\architecture-rules.html" />
  </ItemGroup>

</Project>
